{
  "version": "3.0.0",
  "group": "action",
  "components": [
    {
      "id": "primary-button",
      "summary": "주 동작 버튼",
      "uses": ["press.ink", "loading.breathe"],
      "variants": [
        { "id": "filled", "when": "화면의 주 동작" },
        { "id": "quiet", "when": "보조 동작(다시 입력, 건너뛰기, 다시 시도, 오늘 질문 카드의 쓴 뒤 버튼)",
          "parts": { "container": { "bg": "transparent", "height": { "value": 44, "unit": "px" } }, "label": { "fg": "{color.action.primary}" } } },
        { "id": "destructive", "when": "되돌릴 수 없는 동작", "uses": ["mark.caution"],
          "parts": { "container": { "bg": "{color.text.primary}" }, "label": { "fg": "{color.bg.sheet}", "leading": "mark.caution" } } }
      ],
      "parts": {
        "container": { "bg": "{color.action.primary}", "radius": "{radius.md}", "height": { "value": 52, "unit": "px" }, "paddingX": "{space.20}", "width": "fill" },
        "label": { "fg": "{color.action.on-primary}", "type": "{type.label.lg}", "maxLines": 1 },
        "dots": { "count": 3, "size": { "value": 6, "unit": "px" }, "gap": { "value": 6, "unit": "px" }, "color": "label-color" }
      },
      "states": {
        "pressed": { "pattern": "press.ink" },
        "disabled": { "parts": { "container": { "bg": "{color.disabled.bg}" }, "label": { "fg": "{color.disabled.fg}" } } },
        "loading": { "pattern": "loading.breathe", "note": "글자 자리에 점 세 개. 너비는 그대로", "parts": { "label": { "visible": false }, "dots": { "visible": true } } }
      },
      "haptic": [],
      "a11y": { "role": "button", "label": "글자 그대로", "busyAnnounced": "처리 중", "minTarget": 48 },
      "rules": [
        "스피너를 쓰지 않는다. 처리 중은 점 숨쉬기가 유일한 대체다.",
        "처리 중에는 다시 누를 수 없다.",
        "quiet 변형은 disabled에서 바탕 없이 글자만 color.disabled.fg다."
      ]
    },
    {
      "id": "social-login-button",
      "summary": "소셜 로그인 버튼: 카카오·LINE·Google·Apple (D82, 결정 V39)",
      "uses": ["press.ink", "icon"],
      "variants": [
        { "id": "kakao", "when": "카카오 로그인", "parts": { "container": { "style": "kakao-login-design-guide" } } },
        { "id": "line", "when": "LINE으로 로그인", "parts": { "container": { "style": "line-login-button-guidelines", "bg": "#06C755" }, "label": { "fg": "#FFFFFF", "width": { "value": 198, "unit": "px" }, "widthSource": "LINE 공식 버튼 자산의 구분선 비율을 따른 글자 자리(V46, #475). 다른 제공자는 232px" }, "logo": { "fg": "#FFFFFF", "keepAspect": true }, "separator": { "source": "provider-official-asset", "color": "#000000", "opacity": 0.08, "note": "로고와 글자 사이 세로 구분선. 공식 로고 자산의 구분선을 그대로 씀" }, "pressed": { "overlay": { "color": "#000000", "opacity": 0.3 } }, "disabled": { "bg": "#FFFFFF", "border": { "color": "#E5E5E5", "opacity": 0.6 }, "fg": { "color": "#1E1E1E", "opacity": 0.2 } } } },
        { "id": "google", "when": "Google 계정으로 로그인", "parts": { "container": { "style": "google-sign-in-branding", "lightMode": { "bg": "#FFFFFF", "border": "#747775", "fg": "#1F1F1F" }, "darkMode": { "bg": "#131314", "border": "#8E918F", "fg": "#E3E3E3" }, "borderWidth": { "value": 1, "unit": "px" }, "borderAlign": "inside" }, "label": { "fontFamily": "Google Sans Medium", "fontFallback": "platform-system", "fontSize": { "value": 14, "unit": "px" }, "lineHeight": { "value": 20, "unit": "px" }, "note": "Google Sans에 없는 한글·가나는 플랫폼 시스템 글꼴. Google Identity SDK가 그리는 버튼을 쓸 수 있으면 그것을 우선(가이드 권장)" }, "logo": { "backdrop": "theme-background", "note": "표준 컬러 G. light·dark 테마 버튼 바탕 위에 그대로 놓음(가이드: light·dark·neutral 밖 바탕 금지)" } } },
        { "id": "apple", "when": "Apple로 로그인. iOS·Android 모두 보임, Android는 웹 흐름", "parts": { "container": { "style": "sign-in-with-apple-hig", "lightMode": "black", "darkMode": "white" }, "label": { "fontFamily": "platform-system", "type": "{type.label.lg}" } } }
      ],
      "parts": {
        "container": { "radius": "{radius.md}", "height": { "value": 52, "unit": "px" }, "width": "fill" },
        "stack": { "gap": "{space.12}", "order": { "base": ["kakao", "line", "google", "apple"], "top": { "ko": "kakao", "ja": "line", "en": "google" } } },
        "logo": { "source": "provider-official-asset", "size": { "value": 20, "unit": "px" }, "inset": "{space.16}", "position": "start" },
        "label": { "source": "provider-official-guide", "align": "center" }
      },
      "states": {
        "pressed": { "pattern": "press.ink", "note": "line 변형은 가이드의 검정 30% 덮개(variants.line.parts.pressed)" },
        "loading": { "pattern": "loading.breathe", "note": "누른 버튼만. 나머지 버튼(connected 포함)은 disabled" },
        "disabled": { "note": "다른 버튼이 처리 중일 때. 제공자 색을 바꿀 수 없어 버튼 전체를 흐림. line 변형은 가이드의 비활성 값(variants.line.parts.disabled)", "parts": { "container": { "opacity": 0.4 } } },
        "connected": {
          "note": "login-methods에서만. 로그인 동작이 아니라 연결 상태 줄이라 제공자 색을 쓰지 않음(결정 V39)",
          "parts": {
            "container": { "bg": "{color.bg.sheet}", "border": { "color": "{color.line}", "width": { "value": 1, "unit": "px" } } },
            "logo": { "source": "provider-official-asset", "badge": { "size": { "value": 20, "unit": "px" }, "symbolSize": { "value": 14, "unit": "px" }, "kakao": { "bg": "#FEE500", "symbol": "#191919", "shape": "{radius.xs}" }, "line": { "bg": "#06C755", "symbol": "#FFFFFF", "shape": "{radius.xs}" }, "google": { "bg": "#FFFFFF", "symbol": "full-color", "shape": "{radius.full}" }, "apple": { "lightMode": { "bg": "#000000", "symbol": "#FFFFFF" }, "darkMode": { "bg": "#FFFFFF", "symbol": "#000000" }, "shape": "{radius.xs}" } }, "note": "중립 바탕(bg.sheet)에서도 보이게 로고는 제공자 색 배지(20px) 안의 심볼 14px. Google G는 흰 원 위" },
            "name": { "type": "{type.label.lg}", "fg": "{color.text.primary}", "align": "start", "slot": "ui.login-methods.row", "key": "loginProvider*" },
            "state": { "icon": "check", "weight": "regular", "size": { "value": 14, "unit": "px" }, "gap": "{space.4}", "type": "{type.caption.lg}", "fg": "{color.action.primary}", "position": "end", "inset": "{space.16}", "slot": "ui.login-methods.row", "key": "loginMethodsRowConnected" }
          },
          "onPress": { "component": "dialog", "variant": "destructive", "slot": "login-methods.unlink.confirm" },
          "lastOne": { "pressable": false, "noticeSlot": "login-methods.last.notice", "notice": { "type": "{type.caption.lg}", "fg": "{color.text.secondary}", "marginTop": "{space.12}", "position": "버튼 묶음 아래, 늘 보임" } },
          "a11y": { "label": "제공자 이름, 연결됨", "hint": "loginMethodsRowUnlink", "lastOne": "역할·힌트 없이 라벨 뒤에 안내를 이어 읽음" },
          "loading": { "pattern": "loading.breathe", "note": "떼기 확정 뒤 그 줄 전체가 숨쉼. 끝나면 연결하지 않은 버튼으로 바뀜" },
          "disabled": { "note": "다른 버튼이 처리 중일 때. 다른 상태와 같이 줄 전체 opacity 0.4", "parts": { "container": { "opacity": 0.4 } } }
        }
      },
      "haptic": [],
      "a11y": { "role": "button", "label": "제공자 공식 문구", "minTarget": 48 },
      "rules": [
        "색·로고·문구는 각 제공자의 공식 가이드와 공식 자산을 쓴다. 아이콘 세트에서 가져오지 않는다.",
        "반경·높이·쌓기 간격만 이 명세를 따른다(제공자 가이드가 허용하는 범위에서).",
        "네 버튼은 같은 크기·같은 무게다(D82 ①, App Store 가이드라인 4.8, Google 가이드). 순서는 parts.stack.order: 언어마다 맨 위만 다르고 나머지는 기본 순서다.",
        "connected는 login-methods에서만 쓴다. 연결된 수단도 로그인 화면과 같은 자리에 둔다.",
        "account-merge 인증 단계는 login과 같은 버튼·순서·라벨이고 connected를 쓰지 않는다(V44)."
      ]
    },
    {
      "id": "share-button",
      "summary": "공유",
      "uses": ["press.ink", "icon"],
      "variants": [
        { "id": "icon", "when": "app-bar 동작", "parts": { "icon": { "name": "export", "weight": "light", "size": { "value": 24, "unit": "px" }, "color": "{color.text.primary}" }, "target": { "value": 44, "unit": "px" } } },
        { "id": "soft", "when": "본문 안 공유 입구(미리보기 화면)",
          "parts": {
            "container": { "bg": "{color.status.bg}", "radius": "{radius.md}", "height": { "value": 36, "unit": "px" }, "paddingX": "{space.16}", "gap": "{space.8}" },
            "icon": { "name": "export", "weight": "regular", "size": { "value": 16, "unit": "px" }, "color": "{color.status.fg}" },
            "label": { "type": "{type.label.md}", "fg": "{color.status.fg}" }
          } }
      ],
      "parts": {},
      "states": { "pressed": { "pattern": "press.ink" } },
      "haptic": [],
      "a11y": { "role": "button", "label": "공유", "minTarget": 44 },
      "rules": ["누르면 share-preview 시트를 연다. 시스템 공유 창은 그 시트의 공유 버튼에서 연다."]
    },
    {
      "id": "settings-row",
      "summary": "설정 한 줄",
      "uses": ["press.ink", "icon"],
      "variants": [
        { "id": "navigate", "when": "다음 화면으로", "parts": { "chevron": { "visible": true } } },
        { "id": "value", "when": "값을 고름(시트)", "parts": { "value": { "visible": true }, "chevron": { "visible": true } } },
        { "id": "toggle", "when": "켜고 끔", "parts": { "toggle": { "visible": true }, "chevron": { "visible": false } } },
        { "id": "destructive", "when": "로그아웃·계정 삭제", "uses": ["mark.caution"], "parts": { "label": { "fg": "{color.text.primary}", "fontWeight": 600, "leading": "mark.caution" }, "chevron": { "visible": false } } }
      ],
      "parts": {
        "group": { "bg": "{color.bg.sheet}", "radius": "{radius.md}", "marginBottom": "{space.20}" },
        "row": { "minHeight": { "value": 52, "unit": "px" }, "paddingX": "{space.16}" },
        "divider": { "color": "{color.line}", "width": { "value": 1, "unit": "px" }, "insetStart": "{space.16}" },
        "label": { "type": "{type.body.ui}", "fg": "{color.text.primary}" },
        "value": { "type": "{type.body.ui}", "fg": "{color.text.secondary}" },
        "chevron": { "icon": "caret-right", "weight": "light", "size": { "value": 16, "unit": "px" }, "color": "{color.text.secondary}" },
        "toggle": { "trackOn": "{color.action.primary}", "trackOff": "{color.line}", "thumb": "{color.bg.sheet}" },
        "groupTitle": { "type": "{type.caption.md}", "fg": "{color.text.secondary}", "paddingX": "{space.16}", "marginBottom": "{space.8}" }
      },
      "states": {
        "pressed": { "pattern": "press.ink" },
        "disabled": { "parts": { "label": { "fg": "{color.disabled.fg}" } } }
      },
      "haptic": [{ "when": "toggle 변형 켜고 끔", "strength": "selection" }],
      "a11y": { "role": "button", "label": "글자 + 값", "toggleRole": "switch", "minTarget": 48 },
      "rules": ["묶음 카드 안에서 1px 선으로 나눈다. 카드 사이는 20px 띄운다."]
    },
    {
      "id": "offer-card",
      "summary": "광고 제거권 상품 설명·가격·기간 카드 (D53·D54)",
      "uses": ["icon", "tag.status", "appear.seep"],
      "parts": {
        "container": { "bg": "{color.bg.sheet}", "radius": "{radius.lg}", "padding": "{space.20}" },
        "icon": { "name": "sparkle", "weight": "light", "size": { "value": 28, "unit": "px" }, "color": "{color.action.primary}" },
        "head": { "type": "{type.subtitle}", "fg": "{color.text.primary}", "slot": "ad-free.offer.head", "marginTop": "{space.12}" },
        "price": { "type": "{type.title}", "fg": "{color.text.primary}", "slot": "ad-free.offer.price", "marginTop": "{space.16}", "fontFeatures": ["tnum"] },
        "period": { "type": "{type.caption.lg}", "fg": "{color.text.secondary}", "note": "1개월, 자동 갱신 아님" },
        "status": { "element": "tag.status", "slot": "ad-free.status.remaining" },
        "remaining": { "type": "{type.body.ui}", "fg": "{color.text.primary}", "fontFeatures": ["tnum"] },
        "buy": { "component": "primary-button", "variant": "filled", "marginTop": "{space.20}" },
        "history": { "component": "primary-button", "variant": "quiet", "slot": "ad-free.history.cta" },
        "legal": { "type": "{type.caption.md}", "fg": "{color.text.secondary}", "slot": "ad-free.legal.notice", "marginTop": "{space.12}" }
      },
      "states": {
        "available": { "parts": { "status": { "visible": false }, "remaining": { "visible": false }, "buy": { "visible": true } } },
        "active": { "pattern": "appear.seep", "parts": { "status": { "visible": true }, "remaining": { "visible": true }, "buy": { "visible": false } }, "note": "이용 중: 꼬리표 + 남은 기간·만료일" },
        "purchasing": { "parts": { "buy": { "state": "loading" } } },
        "offline": { "parts": { "buy": { "state": "disabled" } }, "note": "화면 위 notice-banner offline. 구매 내역 버튼은 누를 수 있음(purchase-history가 자기 offline 상태를 가짐)" }
      },
      "haptic": [{ "when": "구매 완료", "strength": "light" }],
      "a11y": { "role": "group", "label": "상품 이름 + 가격 + 기간", "priceAnnounced": "가격과 '자동 갱신 아님'을 함께 읽음" },
      "rules": [
        "가격·기간·자동 갱신 아님 고지는 구매 버튼보다 위에, 같은 카드 안에서 보인다.",
        "이용 중에는 구매 버튼 대신 남은 기간을 보이고, 만료되면 available로 돌아간다.",
        "구매 내역 버튼은 상태와 관계없이 늘 보인다(D88 ②, 구매 복원 버튼 없음).",
        "빨간색·카운트다운·과장 표시를 쓰지 않는다."
      ]
    },
    {
      "id": "purchase-row",
      "summary": "산 상품의 구매 한 건 (D88 ②, 결정 V45)",
      "uses": [
        "tag.status",
        "skeleton.bone"
      ],
      "parts": {
        "group": {
          "bg": "{color.bg.sheet}",
          "radius": "{radius.lg}",
          "paddingX": "{space.16}",
          "note": "줄들을 카드 한 장에 담음"
        },
        "row": {
          "paddingY": "{space.16}",
          "pressable": false,
          "divider": {
            "color": "{color.line}",
            "width": {
              "value": 1,
              "unit": "px"
            },
            "between": "rows-only"
          }
        },
        "product": {
          "type": "{type.subtitle}",
          "fg": "{color.text.primary}",
          "slot": "ui.purchase-product",
          "key": "purchaseProduct*",
          "fallback": "writing 키가 없는 상품은 스토어의 현지화된 상품 이름",
          "overflow": "wrap",
          "note": "말줄임 없이 다음 줄로 감음(스토어 이름은 길이를 알 수 없음)"
        },
        "status": {
          "position": "end",
          "align": "product-first-line",
          "gap": "{space.12}",
          "slot": "ui.purchase-status",
          "active": {
            "element": "tag.status"
          },
          "other": {
            "type": "{type.label.md}",
            "fg": "{color.text.secondary}",
            "bg": "none"
          },
          "note": "사용 중이면 tag.status, 대기·만료·환불은 바탕 없는 글자. 낱말은 상품 종류에 따라 다를 수 있음(D88 ②)",
          "key": "purchaseRowStatus*",
          "maxWidth": {
            "value": 80,
            "unit": "px"
          }
        },
        "meta": {
          "type": "{type.caption.lg}",
          "fg": "{color.text.secondary}",
          "fontFeatures": [
            "tnum"
          ],
          "marginTop": "{space.4}",
          "slot": "ui.purchase-row",
          "purchased": {
            "key": "purchaseRowPurchased",
            "date": "app이 기기 locale의 짧은 날짜 형식으로 만듦"
          },
          "period": {
            "key": "purchaseRowPeriod",
            "source": "server가 준 사용 구간(시작·끝) 그대로"
          },
          "periodOnlyWhen": "server가 사용 기간을 준 상품(기간권·구독). 없으면 구매일만",
          "join": {
            "key": "purchaseRowSeparator"
          }
        }
      },
      "states": {
        "loading": {
          "component": "skeleton",
          "note": "줄 세 개 자리(상품 이름 줄 + meta 줄 bone)"
        }
      },
      "a11y": {
        "role": "none",
        "label": "상품 이름, 상태, 구매일, 사용 기간"
      },
      "rules": [
        "순서는 server가 준 순서 그대로다(최근 구매가 위). app이 다시 정렬하지 않는다.",
        "합치기로 옮겨 온 구매나 산 계정을 표시하지 않는다(D88 ②). 옮겨 온 구매는 이 계정에서 쓰는 구간만 오므로 구매일이 사용 기간 시작보다 이를 수 있다.",
        "누르지 않는 줄이다. 눌림 상태가 없다.",
        "강조는 사용 중 꼬리표 하나다. 빨간색·카운트다운을 쓰지 않는다."
      ]
    }
  ]
}
