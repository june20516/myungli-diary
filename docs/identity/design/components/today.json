{
  "version": "6.2.0",
  "group": "today",
  "components": [
    {
      "id": "date-header",
      "summary": "날짜 머리: 날짜와 요일, 그 아래 음력과 일진 한 줄 (D108, 결정 V78)",
      "uses": [],
      "variants": [
        { "id": "today", "when": "오늘 화면: 날짜, 음력, 일진", "parts": { "iljin": { "visible": true } } },
        { "id": "day-sheet", "when": "그날 시트 머리: 날짜와 음력, 오른쪽에 날의 성격", "parts": { "iljin": { "visible": false }, "trailing": { "component": "hanja-tag", "variant": "emphasis", "slot": "day-sheet.character.label", "position": "날짜 머리 오른쪽 끝", "verticalAlign": "날짜와 음력 두 줄 묶음의 세로 가운데(음력이 없으면 날짜 줄 가운데)", "gapStart": "{space.12}", "overflow": "날짜 글자와 space.12와 태그가 한 줄 폭에 들어가지 않으면(큰 글자 배율) 태그를 날짜 머리 아래 space.12 왼쪽 줄로 내림", "opens": { "sheet": "explain-sheet", "diaryLink": false }, "note": "결정 V109(#932 ③). 전에는 날짜 머리 아래 따로 한 줄" } } }
      ],
      "parts": {
        "solar": { "type": "{type.subtitle}", "fg": "{color.text.primary}", "slot": "today.date.solar", "daySheetSlot": "day-sheet.date.solar", "source": "기기 날짜(프로필 시간대)" },
        "meta": { "type": "{type.caption.lg}", "fg": "{color.text.secondary}", "marginTop": "{space.2}", "order": ["lunar", "iljin"], "gap": "{space.8}", "separator": "none", "whenEmpty": "hide-line-and-gap", "wrap": "칸 단위로 다음 줄(칸 하나는 끊지 않음)" },
        "lunar": { "slot": "today.date.lunar", "daySheetSlot": "day-sheet.date.lunar", "source": "server 오늘 음력(#806 계약 추가). 달력은 CalendarDay.lunar", "whenMissing": "hide" },
        "iljin": { "slot": "today.date.iljin", "source": "Daily.dayPillar", "fontFallback": "{font.family.hanja}", "note": "한글은 UI 글꼴, 간지 한자만 font.family.hanja(근거 시트 원전과 같은 방식)" }
      },
      "states": { "loading": { "skeleton": [{ "bone": "meta", "shape": "textLine", "lines": 1, "width": "50%" }], "note": "날짜 줄은 기기 날짜라 바로 그리고, server 값인 음력과 일진 줄만 뼈" } },
      "haptic": [],
      "a11y": { "role": "header", "label": "날짜, 음력, 일진을 한 덩어리로 읽음", "readsHanja": false, "iljinLabel": "일진은 한글 독음만 읽음(예: 경신일)" },
      "rules": [
        "날짜 줄(type.subtitle) 아래 space.2에 음력과 일진을 한 줄로 둔다. 두 칸은 간격(space.8)으로만 나누고 쉼표나 기호로 잇지 않는다(V47, V52와 같은 이유).",
        "음력이 계약에 없으면(server #806 전) 음력 칸만 빼고 줄은 일진으로 남긴다.",
        "그날 시트(day-sheet 변형)는 날짜와 음력만이고 일진이 없다.",
        "meta 칸이 모두 없으면(그날 시트에서 음력이 계약에 없을 때) 그 줄과 위 space.2 여백을 그리지 않는다. 날짜 줄 하나만 남는다.",
        "누를 수 없는 표시다. 눌림 표시를 두지 않는다."
      ]
    },
    {
      "id": "day-character",
      "summary": "날의 성격 배지와 이유 한 줄",
      "uses": ["tone"],
      "variants": [
        { "id": "good", "when": "YONGSIN_DAY", "parts": { "badge": { "bg": "{color.badge.good.bg}", "fg": "{color.badge.good.fg}" } } },
        { "id": "gwiin", "when": "GWIIN_DAY", "parts": { "badge": { "bg": "{color.badge.gwiin.bg}", "fg": "{color.badge.gwiin.fg}" } } },
        { "id": "gisin", "when": "GISIN_DAY", "parts": { "badge": { "bg": "{color.badge.gisin.bg}", "fg": "{color.badge.gisin.fg}" } } },
        { "id": "ordinary", "when": "ORDINARY_DAY", "parts": { "badge": { "bg": "transparent", "border": { "color": "{color.badge.ordinary.border}", "width": { "value": 1, "unit": "px" } }, "fg": "{color.badge.ordinary.fg}" } } }
      ],
      "parts": {
        "badge": { "radius": "{radius.full}", "type": "{type.label.md}", "paddingX": "{space.12}", "height": { "value": 26, "unit": "px" } },
        "reason": { "type": "{type.caption.lg}", "fg": "{color.text.secondary}", "marginTop": "{space.8}", "trailing": "depth-link inline-end", "segments": "sentence-block" }
      },
      "states": { "loading": { "skeleton": [{ "bone": "badge", "shape": "chip", "width": "72px" }, { "bone": "reason", "shape": "textLine", "lines": 1, "width": "80%" }] } },
      "haptic": [],
      "a11y": { "role": "text", "label": "배지 글자 + 이유", "colorIndependent": true },
      "rules": ["배지는 글자로 날의 성격을 말한다. 색만으로 전하지 않는다.", "이유 줄 끝에 depth-link inline-end가 붙는다.", "배지는 누를 수 없는 표시다. 배지나 배지를 감싼 줄에 눌림 표시를 두지 않는다(F-007, 결정 V61)."]
    },
    {
      "id": "lucky-card",
      "summary": "행운 항목 칩. 누르면 짧은 설명 시트(explain-sheet)가 열림",
      "uses": ["press.ink", "icon", "sheet.enter", "sheet.exit"],
      "variants": [
        { "id": "color", "when": "행운 색", "uses": ["ohaeng.swatch"], "parts": { "lead": { "swatch": { "size": { "value": 14, "unit": "px" }, "radius": "{radius.full}" } } } },
        { "id": "direction", "when": "행운 방향", "parts": { "lead": { "icon": "compass" } } },
        { "id": "number", "when": "행운 숫자", "parts": { "lead": { "icon": "hash" } } },
        { "id": "time", "when": "행운 시간 (구간마다 칩 하나, 결정 V52)", "repeat": { "each": "FocusTimeCard.picks", "max": 2 }, "parts": { "lead": { "icon": "clock" }, "value": { "format": { "ko": "HH:mm~HH:mm", "ja": "HH:mm〜HH:mm", "en": "HH:mm to HH:mm" }, "clock": "24h", "timeZone": "profile", "fontFeatures": ["tnum"] } } }
      ],
      "parts": {
        "chip": { "bg": "{color.bg.sheet}", "border": { "color": "{color.line}", "width": { "value": 1, "unit": "px" }, "placement": "inside" }, "radius": "{radius.full}", "height": { "value": 34, "unit": "px" }, "paddingX": "{space.12}", "gap": "{space.4}" },
        "lead": { "iconWeight": "regular", "iconSize": "adjacent-text", "iconColor": "{color.text.secondary}" },
        "value": { "type": "{type.label.md}", "fg": "{color.text.primary}" },
        "row": { "gap": "{space.8}", "wrap": true },
        "explain": { "component": "explain-sheet", "title": { "source": "항목 이름(칩 스크린리더 라벨의 항목 이름과 같은 낱말)" }, "body": { "segments": "sentence-block" } }
      },
      "states": { "loading": { "skeleton": [{ "bone": "chip", "shape": "chip", "count": 3, "widths": ["72px", "56px", "64px"], "gap": "{space.8}" }] },
        "pressed": { "pattern": "press.ink" },
        "open": { "pattern": "sheet.enter", "parts": { "chip": { "border": { "color": "{color.action.primary}", "width": { "value": 1.5, "unit": "px" }, "placement": "inside" } }, "explain": { "visible": true } } },
        "closed": { "pattern": "sheet.exit", "parts": { "explain": { "visible": false } } }
      },
      "haptic": [],
      "a11y": { "role": "button", "label": "항목 이름 + 값", "opensSheet": true, "minTarget": 44 },
      "rules": [
        "설명은 explain-sheet로 열고 칩 줄 아래에 끼워 넣지 않는다. 시트가 열린 동안 연 칩의 테두리가 1.5px action.primary로 바뀐다(결정 V62, V75).",
        "칩은 bg.sheet 바탕 + 1px line 테두리다. 반투명 chip.bg를 쓰지 않아 오늘 카드, 나 탭 카드, 공유 이미지 그라데이션, 다크 모드 어디서나 테두리로 구분된다. 테두리는 칩 크기 안쪽에 그려 열려도 크기가 그대로다(Q5 ①, 결정 V75).",
        "칩 줄은 화면 폭에 따라 다음 줄로 넘어간다(줄 수 제한 없음, 칩 하나는 끊지 않음).",
        "today 칩 줄은 행운 4종(color·direction·number·time)뿐이고 tag 칩을 두지 않는다(IA v5, D108, 결정 V78). 대표 태그는 사주 기운 섹션의 hanja-tag다. 옛 변형 tag(V35)는 계약 5.0.0에서 지웠다. 칩 줄 전체 최대 5개(색, 방향, 숫자 3 + 시간 2).",
        "share-image의 칩 줄도 행운 4종만이다. time 칩은 첫 구간 하나만 넣는다(칩 수 표 그대로).",
        "time 값은 프로필 시간대 24시간이고, 범위 표기는 언어별이다(ko HH:mm~HH:mm, ja HH:mm〜HH:mm, en HH:mm to HH:mm, writing W44). 구간이 둘이면 구간마다 time 칩 하나를 계약 순서대로 나란히 두고, 구간을 글자로 잇지 않는다(D93, 결정 V52).", "time 칩이 둘이면 어느 쪽을 눌러도 같은 설명(daily.focus_time) 시트가 열리고, 열림 테두리는 누른 칩에만 생긴다. 스크린리더 라벨은 칩마다 항목 이름 + 그 구간."
      ]
    },
    {
      "id": "tag-sentence-list",
      "summary": "\"이 기운에서 나온 오늘 문장\" 목록과 그 태그의 일기 보기 출구 (사주 기운 시트, D108, 결정 V79)",
      "uses": ["list.divider", "press.ink", "page.push"],
      "parts": {
        "head": { "type": "{type.label.md}", "fg": "{color.text.secondary}", "slot": "tag-sheet.sentences.title", "marginBottom": "{space.8}" },
        "row": {
          "sources": ["today.fortune.body", "today.guide.question"],
          "sourceRule": "그 사주 기운 태그로 정해진 오늘 문장만, 오늘 화면 순서대로(보조 문장, 오늘의 질문). 대표 태그 1순위면 둘 다",
          "layout": "label-column",
          "paddingTop": "{space.12}",
          "paddingBottom": "{space.12}",
          "label": { "width": { "value": 52, "unit": "px" }, "type": "{type.caption.md}", "fg": "{color.text.secondary}", "align": "first-baseline", "wrap": { "within": "label", "maxLines": "none", "widthFixed": true, "sentenceWidthKept": true }, "copy": "이름 칸 글자(보조 문장, 오늘의 질문). IA 슬롯 없음(writing 새 슬롯)" },
          "sentence": { "component": "sentence-block", "variant": "body", "marginStart": "{space.8}", "note": "시트 안이라 term 조각은 일반 글자(segments.term.screens 밖)" }
        },
        "divider": { "element": "list.divider" },
        "empty": { "slot": "tag-sheet.sentences.empty", "type": "{type.body.ui}", "fg": "{color.text.secondary}", "visible": false },
        "diaryLink": {
          "slot": "tag-sheet.diary.cta",
          "params": ["tag"],
          "josa": "태그 이름 뒤 조사는 writing josa 규칙(이/가)",
          "label": { "type": "{type.label.lg}", "fg": "{color.action.primary}" },
          "chevron": { "icon": "caret-right", "weight": "regular", "size": "adjacent-text", "color": "link-color", "gap": "{space.2}", "decorative": true },
          "marginTop": "{space.16}",
          "minTarget": 44,
          "target": { "screen": "tag-diary", "presentation": "page", "transition": "page.push" },
          "whenNoDiary": "늘 보임. 그 태그의 일기가 없으면 tag-diary 빈 상태가 맡음(편수를 세지 않음, 관문 답 2026-11-06)"
        }
      },
      "states": {
        "empty": { "when": "이 기운으로 정해진 오늘 문장이 없음(대표 태그 2순위, IA tag-sheet empty)", "parts": { "row": { "visible": false }, "empty": { "visible": true } } },
        "pressed": { "pattern": "press.ink", "note": "diaryLink 글자 둘레에서만. 문장 줄은 누를 수 없음" }
      },
      "haptic": [],
      "a11y": { "role": "list", "label": "머리 글자", "rowLabel": "이름 칸 + 문장", "linkRole": "link", "linkLabel": "글자 그대로(꺾쇠는 읽지 않음)" },
      "rules": [
        "줄마다 왼쪽 이름 칸(52) + 문장(sentence-block body)이고, 줄 사이는 list.divider다. 첫 줄 위와 끝 줄 아래에는 선이 없다.",
        "이름 칸은 폭 52 고정이다. 이름이 넘치면 칸 안에서 줄바꿈하고(ko '오늘의 질문'은 두 줄, ja, en도 같음) 문장 칸 폭은 줄이지 않는다(사용자 확인 2026-11-06).",
        "문장 줄은 누를 수 없다. 오늘 화면의 같은 문장을 다시 보일 뿐이다.",
        "정해진 문장이 없으면(대표 태그 2순위) 줄을 그리지 않고 안내 한 줄(tag-sheet.sentences.empty)을 둔다.",
        "아래 출구는 그 태그가 붙은 내 일기 보기 꺾쇠 링크다(화면 이동, page.push). 편수를 보이지 않고 늘 보인다. 일기가 없으면 tag-diary 빈 상태가 맡는다. 꺾쇠는 원고에 넣지 않고 컴포넌트가 그린다(V29)."
      ]
    },
    {
      "id": "guide-question-card",
      "summary": "가이드 질문과 쓰기 입구",
      "uses": ["seal", "press.ink"],
      "parts": {
        "container": { "bg": "{color.bg.sheet}", "radius": "{radius.lg}", "padding": "{space.20}" },
        "eyebrow": { "type": "{type.caption.md}", "fg": "{color.text.secondary}" },
        "question": { "component": "sentence-block", "variant": "card", "marginTop": "{space.8}" },
        "action": { "marginTop": "{space.16}" }
      },
      "states": { "loading": { "skeleton": [{ "bone": "container", "shape": "card" }, { "bone": "header", "shape": "textLine", "width": "40%" }, { "bone": "question", "shape": "textLine", "lines": 2}, { "bone": "action", "shape": "button", "height": "52px" }] },
        "before": { "labelKey": "todayGuideCta", "parts": { "action": { "component": "primary-button", "variant": "filled" } } },
        "after": {
          "labelKey": "todayGuideCtaWritten",
          "note": "오늘 이미 쓴 날. 버튼은 언제나 새 일기를 연다(D83 ③)",
          "parts": {
            "question": { "fg": "{color.text.secondary}" },
            "action": { "component": "primary-button", "variant": "quiet", "align": "center", "labelFg": "{color.seal.on-soft}" },
            "seal": { "element": "seal", "variant": "soft", "size": { "value": 52, "unit": "px" }, "layer": "behind-action-label", "align": "center" }
          }
        },
        "full": {
          "labelKey": "todayGuideCtaFull",
          "note": "오늘 일기가 상한을 채운 날(D83 ②). after 모양에서 버튼만 막는다",
          "parts": {
            "question": { "fg": "{color.text.secondary}" },
            "action": { "component": "primary-button", "variant": "quiet", "state": "disabled", "align": "center" },
            "seal": { "element": "seal", "variant": "soft", "size": { "value": 52, "unit": "px" }, "layer": "behind-action-label", "align": "center" }
          }
        }
      },
      "haptic": [],
      "a11y": { "role": "group", "label": "질문", "stateAnnounced": "일기를 썼으면 '오늘 일기 씀', 상한을 채웠으면 '더 쓸 수 없음'" },
      "rules": [
        "일기를 쓴 뒤 도장은 버튼 글자 뒤 층에 둔다(일기 종이 도장과 같은 모양, 옅은 변형).",
        "상한을 채운 날(full)에도 도장은 남긴다. 그날 일기를 썼다는 표시이기 때문이다. 막힌 버튼을 눌러도 아무 일도 일어나지 않고 햅틱도 없다."
      ]
    },
    {
      "id": "share-image",
      "summary": "공유 이미지 틀 (라이트 고정)",
      "uses": ["ohaeng.swatch"],
      "variants": [
        { "id": "story", "when": "9:16", "parts": { "canvas": { "ratio": "9:16", "width": { "value": 1080, "unit": "px" }, "height": { "value": 1920, "unit": "px" } }, "reason": { "visible": true }, "sentence": { "lines": "all" }, "chips": { "count": 4 } } },
        { "id": "feed", "when": "4:5", "parts": { "canvas": { "ratio": "4:5", "width": { "value": 1080, "unit": "px" }, "height": { "value": 1350, "unit": "px" } }, "reason": { "visible": false }, "sentence": { "lines": 2 }, "chips": { "count": 3 } } },
        { "id": "square", "when": "1:1", "parts": { "canvas": { "ratio": "1:1", "width": { "value": 1080, "unit": "px" }, "height": { "value": 1080, "unit": "px" } }, "reason": { "visible": false }, "sentence": { "lines": "first-sentence" }, "chips": { "count": 3 } } }
      ],
      "parts": {
        "canvas": { "bg": "{gradient.today}", "theme": "light-fixed" },
        "date": { "type": "{type.caption.md}", "fg": "{color.text.secondary}" },
        "badge": { "component": "day-character", "part": "badge" },
        "sentence": { "component": "sentence-block", "variant": "card", "honorific": true },
        "reason": { "type": "{type.caption.lg}", "fg": "{color.text.secondary}" },
        "chips": { "component": "lucky-card", "interactive": false },
        "logo": { "asset": "logo/lockup.png", "note": "새 앱 아이콘(래스터)과 워드마크 가로 조합, 높이 288px PNG. 1080 캔버스에서 줄여 그림(결정 V99)" },
        "footer": { "slot": "image.footer", "type": "{type.caption.sm}", "fg": "{color.text.secondary}" },
        "preview": { "shadow": "{shadow.raised}", "radius": "{radius.md}" },
        "ratioPicker": { "component": "segmented", "position": "above-preview" }
      },
      "states": { "ratioChanged": { "pattern": "appear.seep" } },
      "haptic": [],
      "a11y": { "role": "image", "label": "오늘 문장 이미지 미리보기", "altText": "문장 전체" },
      "rules": [
        "다크 모드에서도 라이트 토큰으로 그린다(결정 V5).",
        "비율은 공유 미리보기 시트 위 segmented로 사용자가 고른다.",
        "그림 크기는 1080px 폭 기준. 화면 미리보기는 이를 줄여 보인다.", "행운 칩의 time은 구간이 둘이어도 첫 구간 칩 하나만 넣는다. 칩 수는 변형 표 그대로(결정 V52)."
      ]
    }
  ]
}
