{
  "version": "6.0.1",
  "elements": {
    "seal": {
      "summary": "낙관 도장. 로고 낙관 모양을 브랜드 요소로 씀",
      "path": "M1.2 1.5 q8.8 -1.3 17.6 0 q1.2 8.5 0 17 q-8.8 1.3 -17.6 0 q-1.2 -8.5 0 -17 z",
      "viewBox": [0, 0, 20, 20],
      "rotate": -8,
      "contentAlign": "center",
      "variants": {
        "fill": { "color": "{color.seal.fill}", "knock": "{color.seal.knock}", "knockUse": "날짜 숫자를 가는 양각으로 새김, 아이콘은 knock 대신 color.action.on-primary" },
        "soft": { "color": "{color.seal.soft}", "contentColor": "{color.text.primary}" },
        "outline": { "color": "{color.seal.fill}", "width": { "value": 1.6, "unit": "px" } }
      },
      "sizes": [
        { "size": { "value": 26, "unit": "px" }, "where": ["day-cell"] },
        { "size": { "value": 34, "unit": "px" }, "where": ["tab-bar", "reaction-button", "diary-row"] },
        { "size": { "value": 52, "unit": "px" }, "where": ["guide-question-card"] },
        { "size": { "value": 64, "unit": "px" }, "where": ["diary-editor"] }
      ],
      "uses": ["seal.stamp", "seal.erase"],
      "overlap": "겹치는 반투명 도장·길흉 바탕을 섞어 그대로 보임(빼기 처리 없음)"
    },
    "ohaeng.cell": {
      "summary": "오행 칸: 오행 바탕 + 오행 글자",
      "radius": "{radius.sm}",
      "byElement": {
        "wood": { "bg": "{color.ohaeng.wood.bg}", "fg": "{color.ohaeng.wood.fg}" },
        "fire": { "bg": "{color.ohaeng.fire.bg}", "fg": "{color.ohaeng.fire.fg}" },
        "earth": { "bg": "{color.ohaeng.earth.bg}", "fg": "{color.ohaeng.earth.fg}" },
        "metal": { "bg": "{color.ohaeng.metal.bg}", "fg": "{color.ohaeng.metal.fg}" },
        "water": { "bg": "{color.ohaeng.water.bg}", "fg": "{color.ohaeng.water.fg}" }
      },
      "sizes": {
        "pillar": { "height": { "value": 66, "unit": "px" }, "hanja": "{type.hanja.pillar}", "reading": "{type.caption.sm}" },
        "small": { "width": { "value": 40, "unit": "px" }, "height": { "value": 40, "unit": "px" }, "hanjaSize": { "value": 18, "unit": "px" }, "hanjaWeight": 700, "hanjaFamily": "{font.family.hanja}", "where": "luck-pillar" }
      },
      "textScaleMax": 1.3
    },
    "ohaeng.swatch": {
      "summary": "오행 견본: 색 자체를 보여 주는 자리",
      "byElement": {
        "wood": "{color.ohaeng.wood.swatch}",
        "fire": "{color.ohaeng.fire.swatch}",
        "earth": "{color.ohaeng.earth.swatch}",
        "metal": "{color.ohaeng.metal.swatch}",
        "water": "{color.ohaeng.water.swatch}"
      },
      "border": { "color": "{color.swatch.border}", "width": { "value": 1, "unit": "px" } }
    },
    "tone": {
      "summary": "길흉 톤: 배지·날의 성격 한자 태그·달력 칸이 같은 매핑을 씀 (결정 V8·V10, 달력 네 단계 V84)",
      "good": {
        "meaning": "좋음·귀인 (coral 계열)",
        "tag": { "bg": "{color.tag.good.bg}", "fg": "{color.tag.good.fg}" },
        "calendarFill": "{color.calendar.level.good}",
        "calendarFillGreat": "{color.calendar.level.great}",
        "badges": ["{color.badge.good.bg}", "{color.badge.gwiin.bg}"]
      },
      "bad": {
        "meaning": "나쁨 (neutral 채움)",
        "tag": { "bg": "{color.tag.bad.bg}", "fg": "{color.tag.bad.fg}" },
        "calendarFill": "{color.calendar.level.caution}",
        "badges": ["{color.badge.gisin.bg}"]
      },
      "neutral": {
        "meaning": "중립·평범 (테두리만)",
        "tag": { "border": "{color.tag.neutral.border}", "fg": "{color.tag.neutral.fg}" },
        "calendarFill": null,
        "badges": ["{color.badge.ordinary.border}"]
      },
      "a11y": "색만으로 전하지 않음: 스크린리더 라벨에 길흉 낱말을 넣음"
    },
    "tag.status": {
      "summary": "상태 꼬리표: 옅은 sage 알약 (진행 중·다음·지금·올해)",
      "bg": "{color.status.bg}",
      "fg": "{color.status.fg}",
      "type": "{type.label.md}",
      "radius": "{radius.full}",
      "padding": { "x": { "value": 8, "unit": "px" }, "y": { "value": 2, "unit": "px" } }
    },
    "tag.me": {
      "summary": "'나' 꼬리표: 내가 해당하는 칸 표시",
      "bg": "{color.action.primary}",
      "fg": "{color.action.on-primary}",
      "fontSize": { "value": 10, "unit": "px" },
      "fontWeight": 700,
      "fontFamily": "{font.family.ui}",
      "radius": "{radius.full}",
      "position": "top-end-corner-overlap",
      "clippedByCell": false
    },
    "highlight.current": {
      "summary": "현재 강조: 기둥, 칸 바탕 옅은 회색 + 글자 sage 굵게 (결정 V93)",
      "bg": "{color.highlight.bg}",
      "onlyOn": "{color.bg.sheet}",
      "onlyOnRule": "바탕이 화면 바탕(bg.base)과 같은 회색이라 흰 카드(bg.sheet) 위에서만 쓴다. 화면 바탕 위에 두면 보이지 않음",
      "note": "회색으로 둔 이유: sage 꼬리표(tag.status)와 용어 칩(term)이 강조 바탕 위에서도 갈리게(사용자 의견, 관문 Q4 ③ 2026-11-07)",
      "fg": "{color.action.primary}",
      "fontWeight": 700,
      "outlineSeal": false
    },
    "mark.underline-grow": {
      "summary": "펼침 밑줄: 숫자 아래 둥근 막대",
      "color": "{color.action.primary}",
      "width": { "value": 14, "unit": "px" },
      "height": { "value": 2, "unit": "px" },
      "radius": "{radius.full}",
      "gap": "{space.2}",
      "uses": ["mark.underline-grow"]
    },
    "mark.caution": {
      "summary": "경고 표시: 되돌릴 수 없는 동작. 빨간색 없음 (결정 V18)",
      "icon": { "set": "phosphor", "name": "warning-circle", "weight": "fill" },
      "color": "inherit-text",
      "size": "adjacent-text",
      "placement": "before-text-inline"
    },
    "surface.paper": {
      "summary": "종이: 일기 쓰기·보기",
      "bg": "{color.bg.sheet}",
      "radius": "{radius.lg}",
      "padding": "{space.16}",
      "sealReserve": { "size": { "value": 64, "unit": "px" }, "gap": "{space.12}", "align": "bottom-end", "alwaysReserved": true }
    },
    "rail.timeline": {
      "summary": "세로 흐름 줄: 일기 목록 날짜 축",
      "color": "{color.timeline.line}",
      "width": { "value": 1.5, "unit": "px" },
      "position": "date-column-center",
      "span": "요일 아래에서 다음 날짜까지"
    },
    "term": {
      "summary": "용어 표시 (굵게 하지 않음, 결정 V0)",
      "bg": "{color.term.bg}",
      "fg": "{color.term.fg}",
      "radius": "{radius.xs}",
      "fontWeight": "inherit",
      "padding": { "x": "{space.4}" }
    },
    "button.pair": {
      "summary": "두 버튼: 세로로 쌓고 주 버튼이 위 (결정 V60, Q2 ①)",
      "component": "primary-button",
      "stack": { "direction": "vertical", "order": ["filled", "quiet"], "gap": "{space.8}" },
      "height": "same",
      "width": "fill",
      "note": "가로 배치는 쓰지 않음. 확인 창(dialog)의 두 버튼은 dialog 규칙(V65)"
    },
    "keyboard.dismiss": {
      "summary": "키보드 내리기 버튼: 입력칸에 초점이 있는 동안 키보드 바로 위 오른쪽 44 원형 버튼 (결정 V68, V83)",
      "position": "키보드 바로 위 오른쪽", "anchor": "keyboard-inset", "anchorIncludes": ["OS 자동완성과 추천 줄", "플랫폼 키보드 inset"], "inset": "{space.12}",
      "size": { "value": 44, "unit": "px" }, "radius": "{radius.full}", "bg": "{color.bg.sheet}", "shadow": "{shadow.raised}",
      "icon": { "icon": "caret-down", "weight": "regular", "size": "{size.icon.20}", "color": "{color.text.primary}" },
      "action": "키보드를 내림(입력칸 초점 풀기)", "a11y": { "role": "button", "labelSlot": "ui.keyboard.dismiss" },
      "qa": "붙여넣기 막대(iOS 편집 메뉴, Android 클립보드 추천)와 겹치는지 QA에서 확인(Q8)",
      "where": ["text-field focused", "diary-editor focused(edit 본문)"],
      "note": "입력칸에 초점이 있는 동안만. 키보드 inset은 OS 자동완성과 추천 줄을 포함한 플랫폼 값이고, 버튼은 그 위 space.12. 동작 구현은 app #796. 5.0.0에서 text-field와 diary-editor에 겹쳐 있던 값을 이 요소로 뺌"
    },
    "list.divider": {
      "summary": "목록 구분선: 같은 묶음 안 줄 사이 (결정 V58)",
      "color": "{color.line}",
      "width": "{border.width.hairline}",
      "insetX": "{space.16}",
      "insetRule": "묶음 좌우에서 같은 거리. 줄 안쪽 여백(paddingX)과 같음",
      "underLeading": true,
      "between": "rows-only",
      "note": "첫 줄 위와 끝 줄 아래에는 없음. 묶음과 묶음은 선 없이 간격으로 나눔"
    },
    "stem.chip": {
      "summary": "간지 오행 색 칩: band-table 지장간 칸의 천간 한 글자 정사각 칸 (DS1 2단계, 결정 V72)",
      "size": { "value": 22, "unit": "px" },
      "radius": "{radius.sm}",
      "colors": "ohaeng.cell",
      "colorsRule": "ohaeng.cell byElement의 바탕색과 글자색을 그 간지의 오행으로",
      "hanja": { "fontFamily": "{font.family.hanja}", "fontSize": { "value": 13, "unit": "px" }, "fontWeight": 700 },
      "textScaleMax": 1.3,
      "where": ["band-table 지장간 칸"],
      "notFor": "원국 칸(saju-pillars)과 대운, 세운 칸(luck-pillar). 이 칸들은 ohaeng.cell 자체라 같은 색 규칙을 이미 쓰고, 독음과 큰 한자를 담아 22 칸으로 줄일 수 없음(결정 V89)"
    },
    "skeleton.bone": {
      "summary": "skeleton 자리: 실제 요소와 같은 크기·반경",
      "color": "{color.skeleton.bone}",
      "shape": "same-as-content",
      "uses": ["loading.breathe"]
    },
    "icon": {
      "summary": "아이콘: Phosphor (결정 V15, V57)",
      "set": { "name": "Phosphor", "version": "2.1.2", "license": "MIT", "flutter": "phosphor_glyphs", "flutterVersion": "2.1.2+1", "names": "tools/phosphor_names.txt" },
      "weights": { "default": "light", "selected": "regular", "caution": "fill" },
      "adjacentTextWeight": { "rule": "글자 옆 아이콘은 옆 글자 굵기와 짝", "400-500": "light", "600+": "regular" },
      "forbidden": ["bold", "duotone", "thin", "fill (경고 표시 밖)", "직접 그린 아이콘"],
      "scale": ["{size.icon.16}", "{size.icon.20}", "{size.icon.24}", "{size.icon.28}"],
      "adjacentText": [
        { "maxFontSize": 14, "size": "{size.icon.16}" },
        { "maxFontSize": 18, "size": "{size.icon.20}" },
        { "maxFontSize": 22, "size": "{size.icon.24}" },
        { "maxFontSize": null, "size": "{size.icon.28}", "note": "그 위 모든 글자" }
      ],
      "adjacentTextRule": "size가 adjacent-text면 옆 글자 크기가 maxFontSize 이하인 첫 단계. 그림(상자의 0.81)이 옆 한글 높이(글자 크기의 0.861~0.882) 이상인 가장 작은 단계",
      "standalone": { "list-leading": "{size.icon.20}", "tab": "{size.icon.24}", "bar": "{size.icon.24}", "state": "{size.icon.28}" },
      "textScale": {
        "adjacent-text": "단계는 기본 글자 크기로 고르고, 그리는 크기에 기기 글자 배율을 곱함(그 칸의 textScaleMax까지)",
        "standalone": "기기 글자 배율을 따르지 않음(탭 바, 위 막대, 목록 줄 앞, 빈 화면, 키보드 내리기)"
      },
      "missing": "세트에 없는 뜻은 아이콘 없이 글자로 씀"
    },
    "lock.veil": {
      "summary": "잠긴 구역 하나: 또렷한 제목, 또렷한 앞 2~3 단어 + 흐린 자리값 본문 (D60, D106, 결정 V25, V80)",
      "title": { "icon": "lock-simple", "iconWeight": "regular", "iconSize": "adjacent-text", "type": "{type.label.md}", "fg": "{color.text.secondary}", "gap": "{space.4}" },
      "lead": { "type": "{type.sentence.body}", "fg": "{color.text.primary}", "words": "2~3", "source": "server가 준 문장 앞부분(#797)", "selectable": false, "whenMissing": "앞부분이 없으면 자리값만" },
      "body": { "type": "{type.sentence.body}", "fg": "{color.text.primary}", "blur": { "value": 6, "unit": "px" }, "opacity": 0.5, "selectable": false, "marginTop": "{space.8}" },
      "placeholder": { "source": "app", "text": "app이 준비한 자리값 글자(언어별 하나). 실제 내용은 내려받지 않음(D60 ④)", "matchesRealLength": false, "flow": "앞부분 바로 뒤, 같은 줄에서 이어짐", "style": "body" },
      "lines": { "basis": 3, "source": 2, "personal": 3, "sentence-block locked": 2 },
      "linesRule": "앞부분과 자리값을 합한 줄 수. 실제 문장 길이와 맞추지 않음(D106)",
      "a11y": { "label": "구역 제목 + 앞부분 + '잠김'", "order": ["title", "lead", "state"], "stateSlot": "evidence-sheet.a11y.locked", "stateSlotRule": "슬롯은 상태 낱말('잠김')뿐이고 틀에 앞부분 자리를 두지 않음. 제목, 앞부분, 상태 낱말을 따로 받아 이 순서로 이어 읽음", "leadRead": true, "bodyExcluded": true },
      "reduceMotion": "흐림은 대상 자신의 효과라 그대로 둠(결정 V14)",
      "open": { "icon": "lock-simple", "weight": "regular", "size": "adjacent-text", "color": "link-color", "gap": "{space.4}", "placement": "before-label", "decorative": true },
      "openRule": "잠긴 것을 여는 입구는 어디서나 자물쇠 + '열기' 글자(꺾쇠 없음, 결정 V73). 화면 이동 링크(pass)와 광고 보고 열기 버튼은 이 모양이 아님",
      "where": ["depth-link evidenceSheet basis·source·personal", "sentence-block locked (saju-chart.yongsin.basis)"]
    }
  }
}
