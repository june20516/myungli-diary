{
  "version": "4.0.0",
  "group": "diary",
  "components": [
    {
      "id": "diary-row",
      "summary": "일기 줄: 흐름 줄 위 날짜 + 카드(목록), 같은 날 여러 편은 시각 + 한 줄 미리보기 줄",
      "uses": ["rail.timeline", "seal", "press.ink"],
      "variants": [
        {
          "id": "day",
          "when": "일기 목록·태그 모아보기. 그날 일기가 한 편이면 지금 모양(카드 전체가 버튼), 두 편 이상이면 묶음 카드",
          "parts": {
            "group": {
              "when": "그날 일기 두 편 이상",
              "pressable": false,
              "order": ["badge", "entries", "tag"],
              "entriesMarginTop": "{space.4}",
              "preview": { "visible": false },
              "tag": { "marginTop": "{space.8}" },
              "note": "카드 바탕·반경·안쪽 여백은 한 편일 때와 같다. 최상위 preview(2줄) 대신 entry 줄을 쓰고, 태그 위 간격만 space.8로 덮어쓴다. 누를 곳은 entry 줄마다와 태그 칩"
            }
          }
        },
        {
          "id": "entries",
          "when": "오늘(가이드 질문 카드 아래)·그날 시트(일기 머리 아래). 날짜와 날의 성격은 화면이 이미 보여 준다",
          "parts": {
            "dateColumn": { "visible": false },
            "number": { "visible": false },
            "seal": { "visible": false },
            "weekday": { "visible": false },
            "rail": { "visible": false },
            "card": { "visible": false },
            "badge": { "visible": false },
            "preview": { "visible": false },
            "tag": { "visible": false },
            "head": { "screens": ["day-sheet"], "slot": "day-sheet.diary.open", "type": "{type.label.md}", "fg": "{color.text.secondary}", "marginTop": "{space.16}", "marginBottom": "{space.4}", "note": "머리는 아래 줄의 이름이라 아래 내용에 붙여야 묶여 보임(결정 V56)" },
            "container": {
              "byScreen": {
                "today": { "bg": "{color.bg.sheet}", "radius": "{radius.lg}", "paddingX": "{space.16}", "paddingY": "{space.4}", "marginTop": "{space.12}" },
                "day-sheet": "none"
              },
              "whenEmpty": "그리지 않음"
            }
          }
        }
      ],
      "parts": {
        "dateColumn": { "width": { "value": 44, "unit": "px" }, "align": "center" },
        "number": { "fontFamily": "{font.family.ui}", "fontSize": { "value": 18, "unit": "px" }, "fontWeight": 600, "fg": "{color.text.primary}", "fontFeatures": ["tnum"] },
        "seal": { "element": "seal", "variant": "soft", "color": "{color.seal.soft}", "size": { "value": 34, "unit": "px" }, "position": "behind-number-center" },
        "weekday": { "type": "{type.caption.md}", "fg": "{color.text.secondary}", "marginTop": "{space.4}" },
        "rail": { "element": "rail.timeline", "from": "below-weekday", "to": "next-date" },
        "card": { "bg": "{color.bg.sheet}", "radius": "{radius.lg}", "padding": "{space.16}", "marginStart": "{space.12}", "marginBottom": "{space.12}" },
        "badge": { "component": "day-character", "part": "badge" },
        "preview": { "component": "sentence-block", "variant": "preview", "marginTop": "{space.8}" },
        "tag": { "component": "tag-chip", "count": 1, "marginTop": "{space.12}" },
        "entry": {
          "time": { "source": "createdAt", "type": "{type.caption.md}", "fg": "{color.text.secondary}", "fontFeatures": ["tnum"], "wrap": false, "format": "HH:mm", "hourCycle": "h23", "note": "event-row와 같은 24시간제, 앞 0 채움(V46, #475). writing 슬롯 없음" },
          "preview": { "component": "sentence-block", "variant": "preview", "maxLines": 1, "marginStart": "{space.12}", "baseline": "time", "emptyKeepsLineHeight": true },
          "chevron": { "icon": "caret-right", "weight": "light", "size": "{size.icon.16}", "fg": "{color.text.secondary}", "align": "center", "marginStart": "{space.8}" },
          "paddingY": "{space.12}",
          "minHeight": { "value": 48, "unit": "px" },
          "divider": { "style": "dashed", "width": { "value": 1, "unit": "px" }, "dashLength": { "value": 4, "unit": "px" }, "dashGap": { "value": 3, "unit": "px" }, "color": "{color.timeline.entry}", "between": "entries-only", "span": "row", "inMinHeight": true }
        }
      },
      "states": {
        "pressed": { "pattern": "press.ink", "note": "한 편 카드는 카드 안, 묶음 카드와 entries는 누른 entry 줄 안에서만" },
        "loading": { "skeleton": [{ "bone": "dateColumn", "shape": "숫자 원 + 요일 글줄", "variant": "day" }, { "bone": "card", "shape": "card", "variant": "day" }, { "bone": "badge", "shape": "chip", "width": "72px" }, { "bone": "preview", "shape": "textLine", "lines": 2}, { "bone": "tag", "shape": "chip", "width": "56px" }, { "bone": "entry", "shape": "textLine", "rows": 2, "variant": "entries" }], "note": "day는 날짜 열을 바로, 카드는 skeleton. entries는 줄 두 개 높이 skeleton" }
      },
      "haptic": [],
      "a11y": {
        "role": "button",
        "label": "날짜 요일, 배지, 미리보기 첫 줄, 태그",
        "minTarget": 48,
        "group": { "when": "day에서 그날 일기 두 편 이상(묶음 카드). 카드의 role button을 이것으로 바꾼다", "role": "group", "label": "날짜 요일, 배지" },
        "entry": { "when": "묶음 카드 안의 줄과 entries의 줄마다", "role": "button", "label": "시각, 미리보기 첫 줄", "emptyPreview": "본문이 비면 시각만 읽음" }
      },
      "rules": [
        "날짜는 카드 밖 왼쪽 열에 둔다. 숫자는 옅은 도장 가운데.",
        "흐름 줄은 요일 아래에서 시작해 다음 날짜까지 이어진다. 마지막 줄 뒤에는 줄이 없다.",
        "같은 달이 바뀌는 자리에 달 머리(type.subtitle)를 둔다.",
        "같은 날 일기는 작성 순(createdAt 오름차순)으로 server 순서 그대로 놓는다. 같은 분에 쓴 일기도 app이 시각 문자열로 다시 정렬하지 않는다.",
        "같은 날 일기는 몇 편이든 모두 보인다. 접거나 더 보기를 두지 않는다(계정을 합친 날은 상한보다 많을 수 있음).",
        "entry 줄 사이에만 점선을 긋는다. 첫 줄 위와 끝 줄 아래에는 없다. 날짜 사이는 흐름 줄(실선), 같은 날 안은 점선이다.",
        "묶음 카드에서도 흐름 줄은 카드 높이만큼 이어져 다음 날짜까지 간다."
      ]
    },
    {
      "id": "diary-editor",
      "summary": "일기 본문 입력과 보기 (종이)",
      "uses": ["surface.paper", "seal", "seal.stamp", "loading.breathe", "appear.seep"],
      "variants": [
        { "id": "edit", "when": "쓰기·고치기", "parts": { "body": { "editable": true } } },
        { "id": "view", "when": "보기(diary-view)", "parts": { "body": { "editable": false }, "seal": { "visible": true }, "tags": { "visible": true } } }
      ],
      "parts": {
        "paper": { "element": "surface.paper" },
        "date": { "type": "{type.caption.md}", "fg": "{color.text.secondary}" },
        "question": { "type": "{type.caption.lg}", "fg": "{color.text.secondary}", "optional": true },
        "body": { "type": "{type.sentence.body}", "fg": "{color.text.primary}", "minLines": 8, "placeholderFg": "{color.text.secondary}" },
        "seal": { "element": "seal", "variant": "fill", "color": "{color.seal.fill}", "knock": "{color.seal.knock}", "size": { "value": 64, "unit": "px" }, "content": "날짜(M.D)", "position": "paper-bottom-end-reserve" },
        "tags": { "component": "tag-chip", "gap": "{space.8}", "marginTop": "{space.16}" }
      },
      "states": { "loading": { "skeleton": [{ "bone": "paper", "shape": "card" }, { "bone": "body", "shape": "textLine", "lines": 5}] },
        "saving": { "pattern": "loading.breathe", "note": "저장 버튼 점 숨쉬기" },
        "saved": { "pattern": "seal.stamp", "parts": { "seal": { "visible": true } } }
      },
      "motion": {
        "saveSequence": [
          { "step": "button-breathe", "pattern": "loading.breathe" },
          { "step": "scroll-to-paper-bottom", "duration": "{motion.duration.medium}", "easing": "{motion.easing.standard}" },
          { "step": "stamp", "pattern": "seal.stamp" },
          { "step": "tags", "pattern": "appear.seep" },
          { "step": "toast", "component": "toast" }
        ]
      },
      "haptic": [{ "when": "도장이 찍힘", "strength": "light" }],
      "a11y": { "role": "textbox", "label": "일기 본문", "savedAnnounced": "저장됨 + 대표 태그", "minTarget": 48 },
      "rules": [
        "종이 아래 여백에 64px 도장 자리를 쓰는 중에도 늘 비워 둔다. 글이 길어도 도장이 글을 덮지 않는다.",
        "해시태그를 쓰는 입력이 없다. 태그는 저장할 때 엔진이 붙인다.",
        "저장 순서: 버튼 점 숨쉬기 → 종이 맨 아래로 스크롤 → 날짜 도장 찍힘 → 대표 태그 칩 스밈 → 토스트.",
        "저장 응답이 오기 전에는 도장을 찍지 않는다. 실패하면 버튼이 돌아오고 오류 토스트.",
        "보기 화면은 같은 종이에 도장이 이미 찍힌 채로, 아래 태그 칩."
      ]
    },
    {
      "id": "draft-indicator",
      "summary": "초안 저장 상태 (app-bar 오른쪽)",
      "uses": ["icon", "appear.seep", "loading.breathe"],
      "parts": {
        "container": { "gap": "{space.4}", "position": "app-bar-end-before-actions" },
        "icon": { "size": "{size.icon.16}", "weight": "light", "color": "{color.text.secondary}" },
        "label": { "type": "{type.caption.md}", "fg": "{color.text.secondary}" }
      },
      "states": {
        "local": { "pattern": "appear.seep", "parts": { "icon": { "name": "cloud" } }, "note": "기기에 초안 저장됨" },
        "saving": { "pattern": "loading.breathe", "parts": { "icon": { "visible": false } }, "note": "점 세 개" },
        "saved": { "pattern": "appear.seep", "parts": { "icon": { "name": "check" } }, "note": "서버에 저장됨" }
      },
      "haptic": [],
      "a11y": { "role": "status", "liveRegion": "polite", "label": "상태 글자" },
      "rules": ["상태가 바뀔 때만 appear.seep으로 바꿔 그린다. 같은 상태가 반복되면 움직이지 않는다."]
    },
    {
      "id": "tag-chip",
      "summary": "명리 태그 칩 (길흉 톤). 누르면 태그 모아보기",
      "uses": ["tone", "press.ink", "appear.seep"],
      "variants": [
        { "id": "good", "when": "길한 태그", "parts": { "chip": { "bg": "{color.tag.good.bg}", "fg": "{color.tag.good.fg}" } } },
        { "id": "bad", "when": "흉한 태그", "parts": { "chip": { "bg": "{color.tag.bad.bg}", "fg": "{color.tag.bad.fg}" } } },
        { "id": "neutral", "when": "중립 태그", "parts": { "chip": { "bg": "transparent", "border": { "color": "{color.tag.neutral.border}", "width": { "value": 1, "unit": "px" } }, "fg": "{color.tag.neutral.fg}" } } }
      ],
      "parts": {
        "chip": { "radius": "{radius.full}", "type": "{type.label.md}", "fontSize": { "value": 12, "unit": "px" }, "height": { "value": 26, "unit": "px" }, "paddingX": "{space.12}" },
        "text": { "prefix": "#" }
      },
      "states": { "loading": { "skeleton": [{ "bone": "chip", "shape": "chip", "width": "56px" }] },
        "pressed": { "pattern": "press.ink" },
        "appearing": { "pattern": "appear.seep", "note": "저장 순간" }
      },
      "haptic": [],
      "a11y": { "role": "link", "label": "태그 이름 + 길흉 낱말", "colorIndependent": true, "minTarget": 44, "hitSlop": "위아래 9px" },
      "rules": [
        "목록·보기·저장 순간(diary-edit)에 같은 컴포넌트를 쓴다.",
        "톤은 엔진이 준 태그의 길흉 값을 따른다(배지와 같은 V8 규칙)."
      ]
    },
    {
      "id": "diary-summary",
      "summary": "기록 요약 (나 탭 명리일기 회고): 쓴 편수, 날의 성격마다 쓴 수 막대, 자주 붙은 태그",
      "uses": ["tone"],
      "parts": {
        "container": { "bg": "{color.bg.sheet}", "radius": "{radius.lg}", "padding": "{space.16}" },
        "count": { "fontFamily": "{font.family.ui}", "fontSize": { "value": 28, "unit": "px" }, "fontWeight": 700, "fg": "{color.text.primary}", "fontFeatures": ["tnum"], "source": "쓴 일기 편수(server 집계, 새 경로)" },
        "countUnit": { "type": "{type.label.lg}", "fg": "{color.text.primary}", "marginStart": "{space.4}", "baseline": "count", "copy": "편수 단위 글자. IA 슬롯 없음(writing 새 슬롯)" },
        "dayKinds": {
          "head": { "type": "{type.label.md}", "fg": "{color.text.secondary}", "marginTop": "{space.16}", "marginBottom": "{space.8}", "copy": "막대 머리. IA 슬롯 없음(writing 새 슬롯)", "note": "머리는 아래 막대의 이름이라 아래에 붙임(V56과 같은 이유)" },
          "order": ["YONGSIN_DAY", "GWIIN_DAY", "ORDINARY_DAY", "GISIN_DAY"],
          "name": { "type": "{type.label.md}", "fg": "{color.text.primary}", "width": { "value": 72, "unit": "px" }, "source": "날의 성격 이름(writing dayKind 네 키)" },
          "bar": { "height": { "value": 8, "unit": "px" }, "radius": "{radius.full}", "track": "{color.bg.base}", "length": "그 줄의 수 / 네 줄 가운데 가장 큰 수", "zero": "채움 없이 트랙만" },
          "fill": { "YONGSIN_DAY": "{color.badge.good.bg}", "GWIIN_DAY": "{color.badge.gwiin.fg}", "ORDINARY_DAY": "{color.badge.ordinary.border}", "GISIN_DAY": "{color.badge.gisin.fg}" },
          "count": { "type": "{type.numeric.table}", "fg": "{color.text.primary}", "fontFeatures": ["tnum"], "align": "end", "width": { "value": 28, "unit": "px" }, "marginStart": "{space.12}" },
          "row": { "gap": "{space.8}", "minHeight": { "value": 24, "unit": "px" }, "align": "center" }
        },
        "tags": {
          "head": { "type": "{type.label.md}", "fg": "{color.text.secondary}", "marginTop": "{space.16}", "marginBottom": "{space.8}", "copy": "태그 머리. IA 슬롯 없음(writing 새 슬롯)", "note": "dayKinds 머리와 같음" },
          "tag": { "component": "hanja-tag", "variant": "default", "max": 3, "order": "수 많은 순" },
          "count": { "type": "{type.label.md}", "fg": "{color.text.secondary}", "fontFeatures": ["tnum"], "marginStart": "{space.4}", "position": "알약 안 이름 뒤" },
          "gap": "{space.8}",
          "whenEmpty": "머리와 줄을 그리지 않음"
        },
        "notice": { "slot": "my-saju.record.few", "type": "{type.caption.lg}", "fg": "{color.text.secondary}", "marginTop": "{space.12}", "visible": false }
      },
      "states": {
        "few": { "when": "쓴 편수 5편 미만", "threshold": 5, "parts": { "dayKinds": { "visible": false }, "notice": { "visible": true } }, "note": "편수와 (있으면) 태그는 그대로. 0편도 같음" },
        "loading": { "skeleton": [{ "bone": "count", "shape": "textLine", "lines": 1, "width": "96px" }, { "bone": "dayKinds", "shape": "textLine", "rows": 4 }, { "bone": "tags", "shape": "chip", "count": 3, "width": "64px" }], "note": "머리 글자는 바로" }
      },
      "haptic": [],
      "a11y": { "role": "group", "label": "편수, 날의 성격마다 이름과 수, 태그 이름과 수", "barsDecorative": true, "textScaleMax": 1.3 },
      "rules": [
        "막대는 그 날의 성격으로 쓴 수를 네 줄 가운데 가장 큰 수에 견준 길이다. 수는 막대 오른쪽 끝에 고정폭으로 둔다.",
        "막대 색은 날의 성격 톤(V8 배지 매핑의 진한 쪽 색)이고, 이름과 수를 늘 함께 보여 색만으로 전하지 않는다.",
        "자주 붙은 태그는 hanja-tag default(사주 용어 초록) 최대 셋, 수 많은 순. 누르면 뜻 시트(explain-sheet).",
        "쓴 편수가 5편 미만이면 막대를 숨기고 안내 한 줄(my-saju.record.few)을 둔다."
      ]
    }
  ]
}
