{
  "version": "3.2.0",
  "group": "saju",
  "components": [
    {
      "id": "saju-pillars",
      "summary": "원국표 (시·일·월·연)",
      "uses": ["ohaeng.cell", "tag.me", "term"],
      "parts": {
        "columns": { "order": ["hour", "day", "month", "year"], "gap": { "value": 6, "unit": "px" } },
        "header": { "type": "{type.caption.md}", "fg": "{color.text.secondary}", "align": "center" },
        "stemTenGod": { "component": "term-token", "variant": "label", "position": "above-stem" },
        "stem": { "element": "ohaeng.cell", "size": "pillar" },
        "branch": { "element": "ohaeng.cell", "size": "pillar", "marginTop": { "value": 4, "unit": "px" } },
        "branchTenGod": { "component": "term-token", "variant": "label", "position": "below-branch", "basis": "정기" },
        "dayMaster": {
          "border": { "color": "{color.action.primary}", "width": { "value": 2, "unit": "px" }, "inset": true },
          "tag": { "element": "tag.me" },
          "tenGodLabel": { "component": "term-token", "variant": "label", "term": "일간" }
        }
      },
      "states": {
        "time-unknown": { "parts": { "columns": { "hour": "empty-dashed" } }, "note": "시주 칸을 비우고 화면에 notice-banner time-unknown" },
        "loading": { "note": "칸 모양 skeleton" }
      },
      "haptic": [],
      "a11y": { "role": "table", "label": "원국표", "cellLabel": "기둥 이름, 천간·지지 한자와 독음, 오행, 십성", "textScaleMax": 1.3 },
      "rules": [
        "열 순서와 배치는 다른 만세력과 같게 둔다(대조·신뢰).",
        "'나' 꼬리표는 칸이 자르지 않게 칸 밖 층에 그린다.",
        "시간 모름이면 시주 칸은 점선 테두리 빈 칸이다."
      ]
    },
    {
      "id": "ohaeng-bar",
      "summary": "오행 분포",
      "uses": ["ohaeng.swatch"],
      "parts": {
        "bar": { "height": { "value": 10, "unit": "px" }, "radius": "{radius.full}", "segmentGap": { "value": 2, "unit": "px" }, "fill": "ohaeng.swatch 비례" },
        "legend": { "columns": 5, "marginTop": "{space.12}" },
        "swatch": { "element": "ohaeng.swatch", "size": { "value": 12, "unit": "px" }, "radius": "{radius.full}" },
        "name": { "type": "{type.caption.md}", "fg": "{color.text.primary}" },
        "count": { "type": "{type.numeric.table}", "fg": "{color.text.primary}" }
      },
      "states": {
        "zero": { "parts": { "swatch": { "opacity": 0.35 }, "count": { "fg": "{color.text.secondary}" } } }
      },
      "haptic": [],
      "a11y": { "role": "img", "label": "목 N, 화 N, 토 N, 금 N, 수 N" },
      "rules": ["막대 순서는 목·화·토·금·수.", "0개인 오행은 막대에 칸이 없고 범례 견본만 흐리다."]
    },
    {
      "id": "manse-table",
      "summary": "만세력 기본 표 (십성·지장간·12운성·신살)",
      "uses": ["ohaeng.cell", "term"],
      "parts": {
        "grid": { "columns": ["hour", "day", "month", "year"], "rowHeaderWidth": { "value": 52, "unit": "px" }, "divider": { "color": "{color.line}", "width": { "value": 1, "unit": "px" } } },
        "rowHeader": { "component": "term-token", "variant": "label", "rows": ["지장간", "12운성", "신살"] },
        "top": { "stem": { "element": "ohaeng.cell", "size": "mini" }, "branch": { "element": "ohaeng.cell", "size": "mini" } },
        "value": { "type": "{type.body.ui}", "fg": "{color.text.primary}", "align": "center" },
        "hiddenStems": {
          "hanja": { "fontFamily": "{font.family.hanja}" },
          "reading": { "type": "{type.caption.sm}", "fg": "{color.text.secondary}" },
          "tenGod": { "component": "term-token", "variant": "label", "position": "below-stem", "marginTop": { "value": 2, "unit": "px" }, "source": "HiddenStem.tenGod" },
          "stack": { "direction": "vertical", "gap": "{space.4}", "order": "계약 배열 순서", "note": "지장간 하나 = 한자와 독음 한 줄 + 그 아래 십성 한 줄. 글자 크기와 상관없이 늘 두 줄" }
        },
        "twelveStages": { "component": "term-token", "variant": "inline", "type": "{type.body.ui}", "fallback": "사전 이름이 없으면 value 글자(한자), 한자도 없으면 비움" },
        "shinsal": { "component": "term-token", "variant": "inline", "type": "{type.body.ui}", "stack": { "direction": "vertical", "gap": "{space.4}" }, "fallback": "사전 이름이 없으면 value 글자(한자), 한자도 없으면 비움" },
        "row": { "align": "top", "height": "그 줄에서 가장 높은 칸" }
      },
      "states": { "time-unknown": { "parts": { "grid": { "hour": "empty" } } } },
      "haptic": [],
      "a11y": { "role": "table", "label": "만세력 표", "rowHeaderAnnounced": true, "cellLabel": "행 이름, 기둥 이름, 값(지장간은 한자와 독음, 십성 순서로 하나씩)", "textScaleMax": 1.3 },
      "rules": [
        "열 순서는 원국표와 같다.",
        "행 머리 용어는 모두 term-token(누르면 풀이).",
        "지장간 십성은 늘 지장간 아래 줄이다. 칸이 좁을 때만 줄을 바꾸지 않아 1.3배에서도 모양이 같다.",
        "같은 줄의 칸은 위로 맞추고 가장 높은 칸만큼 줄이 늘어난다. 칸마다 높이가 달라도 줄 선이 어긋나지 않는다.",
        "신살이 여러 개면 한 줄에 하나씩 쌓는다."
      ]
    },
    {
      "id": "daeun-table",
      "summary": "대운·세운 표",
      "uses": ["ohaeng.cell", "highlight.current", "tag.status"],
      "parts": {
        "daeun": {
          "scroll": "horizontal",
          "pillar": { "width": { "value": 52, "unit": "px" }, "gap": { "value": 4, "unit": "px" } },
          "age": { "type": "{type.numeric.table}", "fg": "{color.text.secondary}", "basis": "한국식 나이 (core C22)" },
          "stemTenGod": { "component": "term-token", "variant": "label", "position": "above-stem", "marginBottom": { "value": 4, "unit": "px" }, "source": "DaeunPeriod.stemTenGod" },
          "cells": { "element": "ohaeng.cell", "size": "mini", "count": 2 },
          "branchTenGod": { "component": "term-token", "variant": "label", "position": "below-branch", "marginTop": { "value": 4, "unit": "px" }, "basis": "정기", "source": "DaeunPeriod.branchTenGod" },
          "twelveStage": { "component": "term-token", "variant": "label", "position": "below-branchTenGod", "marginTop": { "value": 2, "unit": "px" }, "source": "DaeunPeriod.twelveStage" },
          "startYear": { "type": "{type.numeric.table}", "fg": "{color.text.secondary}" },
          "order": ["age", "stemTenGod", "cells", "branchTenGod", "twelveStage", "startYear"]
        },
        "seun": {
          "grid": { "columns": 5, "rows": 2 },
          "scope": "지금 대운 10년",
          "stemTenGod": { "component": "term-token", "variant": "label", "position": "above-stem", "marginBottom": { "value": 4, "unit": "px" }, "source": "SeunYear.tenGod" },
          "cells": { "element": "ohaeng.cell", "size": "mini" },
          "year": { "type": "{type.numeric.table}", "fg": "{color.text.secondary}" }
        },
        "label": { "maxWidth": "기둥·칸 폭", "maxLines": 2, "align": "center", "overflow": "낱말 단위로 두 줄까지 줄바꿈. 낱말 하나가 폭보다 넓으면 글자를 type.caption.sm 크기까지 줄임. 말줄임 없음", "fallback": "사전 이름이 없으면 한자, 한자도 없으면 칩 없이 자리만 남김" },
        "currentLabel": { "element": "tag.status" }
      },
      "states": {
        "current": { "parts": { "daeun": { "pillar": { "element": "highlight.current", "bg": "{color.status.bg}" }, "age": { "fg": "{color.action.primary}", "fontWeight": 700 } }, "currentLabel": { "visible": true } }, "note": "지금 대운 기둥 + '지금'" },
        "thisYear": { "parts": { "seun": { "cell": { "element": "highlight.current", "bg": "{color.status.bg}" }, "year": { "fg": "{color.action.primary}", "fontWeight": 700 } }, "currentLabel": { "visible": true } }, "note": "올해 세운 칸 + '올해'" }
      },
      "haptic": [],
      "a11y": { "role": "table", "label": "대운 N세부터 …", "cellLabel": "나이, 천간 십성, 천간·지지 한자와 독음, 지지 십성, 12운성, 시작 연도(세운은 연도, 십성, 한자와 독음)", "currentAnnounced": "지금·올해", "textScaleMax": 1.3 },
      "rules": [
        "처음 열 때 지금 대운이 보이게 가로로 넘겨 둔다(움직임 없이).",
        "지금·올해 강조에 낙관 윤곽을 쓰지 않는다. 낙관 윤곽은 칸 하나 단위(달력 오늘)에만.",
        "십성·12운성 칩은 원국표와 같은 term-token label이다. 누르면 풀이 시트이고 근거 보기에서 그 자리의 원국 개인 해석으로 이어진다(D60).",
        "대운 기둥은 부품 줄(order)마다 높이를 맞춘다. 한 기둥의 라벨이 두 줄이면 같은 줄의 모든 기둥이 그 높이를 따라 간지 칸이 가로로 나란하다. 세운도 같은 행 다섯 칸의 십성 줄 높이를 맞춘다.",
        "세운은 계약에 천간 십성만 있어 천간 위 한 칩이다."
      ]
    }
  ]
}
