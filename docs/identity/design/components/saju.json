{
  "version": "6.1.1",
  "group": "saju",
  "components": [
    {
      "id": "saju-pillars",
      "summary": "원국표 (시·일·월·연)",
      "uses": ["ohaeng.cell", "tag.me", "term"],
      "parts": {
        "columns": { "order": ["hour", "day", "month", "year"], "gap": "{space.8}" },
        "header": { "type": "{type.caption.md}", "fg": "{color.text.secondary}", "align": "center", "slot": "ui.saju.header" },
        "stemTenGod": { "component": "term-token", "variant": "label", "position": "above-stem" },
        "stem": { "element": "ohaeng.cell", "size": "pillar" },
        "branch": { "element": "ohaeng.cell", "size": "pillar", "marginTop": "{space.4}" },
        "branchTenGod": { "component": "term-token", "variant": "label", "position": "below-branch", "basis": "정기" },
        "dayMaster": {
          "border": { "color": "{color.action.primary}", "width": { "value": 2, "unit": "px" }, "inset": true },
          "tag": { "element": "tag.me", "slot": "ui.saju.tag", "maxWidth": "기둥 폭", "maxLines": 1, "note": "오른쪽 위 모서리에 붙여 왼쪽으로 늘어남" },
          "tenGodLabel": { "component": "term-token", "variant": "label", "term": "일간" }
        }
      },
      "states": {
        "time-unknown": { "parts": { "columns": { "hour": "empty-dashed" } }, "note": "시주 칸을 비우고 화면에 notice-banner time-unknown" },
        "loading": { "skeleton": [{ "bone": "cells", "shape": "ohaeng.cell 칸", "note": "머리 글자는 바로" }], "note": "칸 모양 skeleton" }
      },
      "haptic": [],
      "a11y": { "role": "table", "label": "원국표", "cellLabel": "기둥 이름, 천간·지지 한자와 독음, 오행, 십성", "textScaleMax": 1.3 },
      "rules": [
        "열 순서와 배치는 다른 만세력과 같게 둔다(대조·신뢰).",
        "'나' 꼬리표는 칸이 자르지 않게 칸 밖 층에 그린다.",
        "시간 모름이면 시주 칸은 점선 테두리 빈 칸이다."
      ]
    },
    {
      "id": "ohaeng-bar",
      "summary": "오행 분포",
      "uses": ["ohaeng.swatch"],
      "parts": {
        "bar": { "height": { "value": 10, "unit": "px" }, "radius": "{radius.full}", "segmentGap": { "value": 2, "unit": "px" }, "fill": "ohaeng.swatch 비례", "segmentBorder": { "color": "{color.swatch.border}", "width": { "value": 1, "unit": "px" }, "placement": "inside", "note": "칸마다 견본 테두리. 흰 금 칸이 흰 카드에 묻히지 않게(결정 V98)" } },
        "legend": { "columns": 5, "marginTop": "{space.12}" },
        "swatch": { "element": "ohaeng.swatch", "size": { "value": 12, "unit": "px" }, "radius": "{radius.full}" },
        "name": { "type": "{type.caption.md}", "fg": "{color.text.primary}" },
        "count": { "type": "{type.numeric.table}", "fg": "{color.text.primary}" }
      },
      "states": { "loading": { "skeleton": [{ "bone": "bar", "shape": "막대 전체 폭" }, { "bone": "legend", "shape": "textLine", "lines": 1}] },
        "zero": { "parts": { "swatch": { "opacity": 0.35 }, "count": { "fg": "{color.text.secondary}" } } }
      },
      "haptic": [],
      "a11y": { "role": "img", "label": "목 N, 화 N, 토 N, 금 N, 수 N" },
      "rules": ["막대 순서는 목·화·토·금·수.", "0개인 오행은 막대에 칸이 없고 범례 견본만 흐리다.", "막대 칸과 범례 견본은 모두 swatch.border 테두리를 둔다(금 흰색, 수 먹색, V98)."]
    },
    {
      "id": "manse-table",
      "summary": "만세력 표: 내 일간 기준 줄과 지장간, 12운성, 신살 띠. 네 열 속성 띠 표(band-table)로 그림 (IA v5, 결정 V89)",
      "uses": [],
      "parts": {
        "basis": {
          "slot": "saju-chart.manse.basis",
          "params": ["stem"],
          "type": "{type.caption.lg}",
          "fg": "{color.text.secondary}",
          "stemGlyph": { "fontFamily": "{font.family.hanja}" },
          "marginBottom": "{space.12}",
          "note": "누를 수 없는 글자 한 줄. origin의 초록 바탕은 누르면 뜻 시트인 용어 칩과 헷갈려 쓰지 않음(V73)"
        },
        "table": { "component": "band-table", "bands": ["hiddenStems", "twelveStages", "shinsal"] }
      },
      "states": {
        "loading": { "skeleton": [{ "bone": "basis", "shape": "textLine", "lines": 1, "width": "50%" }, { "bone": "table", "shape": "band-table loading" }], "note": "기준 줄은 일간 값이라 뼈 한 줄" },
        "time-unknown": { "parts": { "table": { "hour": "모든 띠가 empty" } } }
      },
      "haptic": [],
      "a11y": { "role": "group", "label": "기준 줄은 글자 그대로, 표는 band-table 표 읽기", "textScaleMax": 1.3 },
      "rules": [
        "만세력과 대운 탭은 원국 칸(사주 블록)을 다시 보이지 않는다. 네 열이 원국표와 같은 순서라 원국 탭과 대조된다(IA 시안 E).",
        "옛 왼쪽 행 머리 열(52)과 위 mini 칸은 없다. 띠 이름은 band-table 띠 머리줄의 용어 칩이다(2026-11-07, V49, V53 개정).",
        "지장간은 stem.chip(오행 바탕색과 글자색) + 십성 한 줄이 하나이고, 지장간 여럿은 세로로 쌓는다."
      ]
    },
    {
      "id": "daeun-table",
      "summary": "대운, 세운 줄: luck-pillar 칸을 가로로 넘기는 두 줄과 scroll-hint (IA v5, 결정 V90)",
      "uses": ["highlight.current", "tag.status"],
      "parts": {
        "rows": {
          "order": ["daeun", "seun"],
          "header": { "component": "section-header", "variant": "plain", "slots": { "daeun": ["saju-chart.daeun.title", "saju-chart.daeun.desc"], "seun": ["saju-chart.seun.title", "saju-chart.seun.desc"] }, "note": "섹션 제목 아래 한 줄 설명을 늘 보임(ⓘ 없음)" }
        },
        "row": {
          "container": { "bg": "{color.bg.sheet}", "radius": "{radius.lg}", "paddingY": "{space.12}" },
          "scroll": "horizontal",
          "paddingX": "{space.12}",
          "pillar": { "component": "luck-pillar", "variant": "column" },
          "gap": "{space.4}",
          "hint": { "component": "scroll-hint" }
        },
        "daeun": { "source": "Chart.daeun.periods", "current": "지금 대운 칸은 luck-pillar current" },
        "seun": { "source": "Chart.seun", "scope": "지금 대운 10년", "current": "올해 칸은 luck-pillar thisYear", "note": "5×2 격자 대신 대운과 같은 가로 줄(origin, IA v5). 칸 폭이 같다. 두 줄은 따로 넘김" },
        "label": { "maxWidth": "기둥 폭", "maxLines": 2, "align": "center", "overflow": "낱말 단위로 두 줄까지 줄바꿈. 낱말 하나가 폭보다 넓으면 글자를 type.caption.sm 크기까지 줄임. 말줄임 없음", "fallback": "사전 이름이 없으면 한자, 한자도 없으면 칩 없이 자리만 남김" },
        "currentLabel": { "component": "luck-pillar", "part": "currentTag" }
      },
      "states": { "loading": { "skeleton": [{ "bone": "pillars", "shape": "luck-pillar loading", "count": "화면에 보이는 기둥 수" }], "note": "섹션 제목과 설명은 UI 슬롯이라 바로" } },
      "haptic": [],
      "a11y": { "role": "list", "label": "대운 줄, 세운 줄 각각 목록", "itemLabel": "luck-pillar 그룹 읽기", "currentAnnounced": "지금, 올해", "textScaleMax": 1.3 },
      "rules": [
        "처음 열 때 지금 대운, 올해 세운 칸이 보이게 줄을 넘겨 둔다(움직임 없이). 그 칸이 줄 가운데 오면 양쪽에 더 있는 쪽이 모두 흐려 보인다.",
        "지금, 올해 강조에 낙관 윤곽을 쓰지 않는다. 낙관 윤곽은 칸 하나 단위(달력 오늘)에만.",
        "십성, 12운성 칩은 원국표와 같은 term-token label이다. 누르면 뜻 시트이고 근거 보기에서 그 자리의 원국 개인 해석으로 이어진다(D60).",
        "같은 줄의 기둥은 부품 줄마다 높이를 맞춘다. 한 기둥의 라벨이 두 줄이면 같은 줄의 모든 기둥이 그 높이를 따라 간지 칸이 가로로 나란하다.",
        "세운은 계약에 천간 십성만 있어 천간 위 칩 하나이고, 지지 십성, 12운성, 시작 연도 자리가 없다.",
        "가로로 넘기는 줄은 scroll-hint를 둔다. 글자 안내(옆으로 넘겨 보세요)는 쓰지 않는다."
      ]
    },
    {
      "id": "luck-pillar",
      "summary": "대운, 세운 기둥 한 칸: 위 나이 또는 연도, 천간 십성, 천간과 지지 칸, 지지 십성. 지금 대운과 올해 세운은 강조",
      "uses": ["ohaeng.cell", "highlight.current", "tag.status", "term"],
      "variants": [
        { "id": "column", "when": "사주 표 대운과 세운 줄(saju-chart). 가로로 넘기는 줄의 기둥 하나" },
        {
          "id": "compact",
          "when": "나 탭 올해와 지금(my-saju). 지금 대운과 올해 세운 두 줄 요약",
          "parts": {
            "layout": { "direction": "horizontal", "rows": ["daeun", "seun"], "rowGap": "{space.16}" },
            "cells": { "direction": "vertical", "gap": "{space.4}" },
            "info": { "marginStart": "{space.12}", "order": ["head", "period", "tenGods"], "align": "top" },
            "head": { "tag": { "element": "tag.status", "slot": "ui.saju.tag" }, "kind": { "component": "term-token", "variant": "label", "terms": ["대운", "세운"], "note": "사주 용어라 용어 칩(누르면 뜻 시트)" }, "gap": "{space.4}" },
            "period": { "type": "{type.caption.lg}", "fg": "{color.text.secondary}", "fontFeatures": ["tnum"], "marginTop": "{space.4}", "source": "대운은 나이 범위(한국식 나이, core C22)와 연도 범위, 세운은 연도와 그해 나이", "copy": "문구 틀은 IA 슬롯 없음(writing 새 슬롯)" },
            "tenGods": { "component": "term-token", "variant": "label", "order": ["stem", "branch"], "gap": "{space.4}", "marginTop": "{space.4}", "note": "세운은 천간 십성 하나(계약 SeunYear.tenGod)" },
            "topLabel": { "visible": false },
            "stemTenGod": { "visible": false },
            "branchTenGod": { "visible": false },
            "currentTag": { "visible": false },
            "twelveStage": { "visible": false },
            "startYear": { "visible": false },
            "highlight": "none",
            "onCard": { "bg": "{color.bg.sheet}", "note": "두 줄이 모두 지금이라 여러 칸 가운데 가릴 것이 없어 강조 바탕을 칠하지 않음(사용자 결정 2026-11-06, origin). 흰 카드 위라 꼬리표(tag.status 알약)와 용어 칩(term, radius.xs)이 바탕과 구분됨" }
          }
        }
      ],
      "parts": {
        "order": ["topLabel", "stemTenGod", "stem", "branch", "branchTenGod", "twelveStage", "startYear", "currentTag"],
        "container": { "width": { "value": 52, "unit": "px" }, "radius": "{radius.md}", "padding": "{space.4}", "align": "center", "highlightCovers": ["topLabel", "stemTenGod", "stem", "branch", "branchTenGod", "twelveStage", "startYear"] },
        "topLabel": { "type": "{type.numeric.table}", "fg": "{color.text.secondary}", "source": "대운은 시작 나이(한국식 나이, core C22), 세운은 연도" },
        "stemTenGod": { "component": "term-token", "variant": "label", "marginTop": "{space.4}", "source": "DaeunPeriod.stemTenGod, SeunYear.tenGod" },
        "stem": { "element": "ohaeng.cell", "size": "small", "marginTop": "{space.4}" },
        "branch": { "element": "ohaeng.cell", "size": "small", "marginTop": "{space.4}" },
        "branchTenGod": { "component": "term-token", "variant": "label", "marginTop": "{space.4}", "basis": "정기", "source": "DaeunPeriod.branchTenGod", "seun": "계약에 없어 그리지 않음. 세운 줄은 모든 칸에 없어 자리를 남길 이유가 없음(2026-11-07, 세운이 가로 줄이 됨)" },
        "twelveStage": { "component": "term-token", "variant": "label", "marginTop": "{space.2}", "source": "DaeunPeriod.twelveStage", "seun": "그리지 않음(계약에 없음)", "note": "daeun-table 대운 기둥에서 옮김" },
        "startYear": { "type": "{type.numeric.table}", "fg": "{color.text.secondary}", "marginTop": "{space.4}", "source": "DaeunPeriod.startYear", "seun": "그리지 않음(위 글자가 연도)", "note": "daeun-table 대운 기둥에서 옮김" },
        "currentTag": { "element": "tag.status", "slot": "ui.saju.tag", "position": "기둥 바탕 밖 아래 가운데(꼬리표 줄)", "outsideHighlight": true, "marginTop": "{space.4}", "visible": false, "maxWidth": "기둥 둘과 그 사이 간격", "maxLines": 1, "overflow": "기둥보다 넓으면 이웃 기둥 아래 빈 꼬리표 자리로 넘침. 줄 양 끝 밖으로는 나가지 않게 그 끝에 맞춤(결정 V53). 꼬리표는 줄에 하나뿐이라 이웃 자리가 빔" }
      },
      "states": {
        "current": { "when": "지금 대운", "parts": { "container": { "element": "highlight.current", "bg": "{color.highlight.bg}" }, "topLabel": { "fg": "{color.action.primary}", "fontWeight": 700 }, "currentTag": { "visible": true, "label": "지금" } } },
        "thisYear": { "when": "올해 세운", "parts": { "container": { "element": "highlight.current", "bg": "{color.highlight.bg}" }, "topLabel": { "fg": "{color.action.primary}", "fontWeight": 700 }, "currentTag": { "visible": true, "label": "올해" } } },
        "loading": { "skeleton": [{ "bone": "cells", "shape": "ohaeng.cell 칸", "count": 2 }, { "bone": "tenGods", "shape": "chip", "width": "36px" }], "note": "꼬리표와 위 글자는 그리지 않음" }
      },
      "haptic": [],
      "a11y": { "role": "group", "label": "나이 또는 연도, 천간 십성, 천간 지지 한자와 독음, 지지 십성", "currentAnnounced": "지금, 올해", "textScaleMax": 1.3 },
      "rules": [
        "지금, 올해 강조에 낙관 윤곽을 쓰지 않는다. 낙관 윤곽은 칸 하나 단위(달력 오늘)에만.",
        "십성 칩은 term-token label이고 누르면 뜻 시트(explain-sheet)다.",
        "compact는 두 줄 모두 지금이라 여러 칸 가운데 가릴 것이 없어 강조 바탕을 칠하지 않는다. 꼬리표(지금, 올해)는 기둥 아래 대신 줄 머리에 용어 칩(대운, 세운)과 함께 둔다.",
        "기둥 칸은 기둥 사이에 같은 줄 높이를 맞춘다(daeun-table 높이 맞춤과 같음).",
        "column의 꼬리표(지금, 올해)는 강조 바탕 밖 아래에 둔다(관문 Q1 ①, 결정 V90). 줄에 하나뿐인 꼬리표가 이웃 기둥 아래로 넘칠 수 있게(V53) 바탕과 따로 둔다. 강조 바탕은 옅은 회색(V93)이라 sage 꼬리표와 다르다."
      ]
    },
    {
      "id": "birth-info-row",
      "summary": "출생 정보 줄: 쉼표 없이 칸 셋(달력 종류 꼬리표와 날짜, 시진 한자 태그와 시간, 성별 알약)을 세로선으로 나눔 (결정 V88)",
      "uses": [],
      "parts": {
        "cells": { "order": ["date", "hour", "gender"], "direction": "horizontal", "align": "center", "wrap": "넘치면 칸 단위로 다음 줄. 칸 안에서는 줄을 바꾸지 않음", "rowGap": "{space.8}" },
        "divider": { "width": { "value": 1, "unit": "px" }, "height": { "value": 16, "unit": "px" }, "color": "{color.line}", "marginX": "{space.12}", "between": "같은 줄의 칸 사이", "note": "목록 구분선(list.divider)이 아니라 칸 사이 세로선. 줄이 바뀐 칸 앞에는 긋지 않음" },
        "date": {
          "calendarKind": { "type": "{type.caption.sm}", "fg": "{color.text.secondary}", "border": { "color": "{color.line}", "width": "{border.width.hairline}" }, "radius": "{radius.xs}", "paddingX": "{space.4}", "source": "프로필 달력 종류(양력, 음력). 음력 윤달이면 뒤에 윤달 낱말(account-choice 사주 줄과 같은 낱말, 결정 V48)" },
          "value": { "type": "{type.label.md}", "fg": "{color.text.primary}", "fontFeatures": ["tnum"], "marginStart": "{space.4}", "source": "프로필 출생 날짜", "format": "언어별 숫자 날짜(ko 1990.5.15)" }
        },
        "hour": {
          "tag": { "component": "hanja-tag", "variant": "ganji", "glyph": "시주 지지 한자", "name": "시진 이름(ko 미시)", "copy": "writing 새 슬롯(시진 이름 틀, 매개변수 지지)", "interactive": false, "note": "시진 뜻 원고가 없어 누를 수 없는 표시(hanja-tag notInteractiveIn, 관문 질문 Q3)" },
          "value": { "type": "{type.label.md}", "fg": "{color.text.primary}", "fontFeatures": ["tnum"], "marginStart": "{space.8}", "source": "프로필 출생 시각", "format": "기기 시간 형식" }
        },
        "gender": { "use": "pill", "source": "프로필 성별", "copy": "writing 새 슬롯(성별 한 낱말)" },
        "pill": { "height": { "value": 24, "unit": "px" }, "radius": "{radius.full}", "paddingX": "{space.8}", "bg": "transparent", "border": { "color": "{color.tag.neutral.border}", "width": { "value": 1, "unit": "px" } }, "type": "{type.label.md}", "fg": "{color.tag.neutral.fg}", "note": "성별과 시간 모름이 같은 중립 알약. 색으로 성별을 나누지 않음" }
      },
      "states": {
        "time-unknown": { "parts": { "hour": { "tag": { "visible": false }, "value": { "visible": false }, "unknown": { "use": "pill", "copy": "시간 모름(writing 새 슬롯, 출생 시간 입력의 모름과 같은 낱말)" } } } },
        "loading": { "skeleton": [{ "bone": "row", "shape": "textLine", "lines": 1, "width": "70%" }], "note": "프로필 값이라 머리 제목 아래 뼈 한 줄" }
