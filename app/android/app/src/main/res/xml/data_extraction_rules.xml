<?xml version="1.0" encoding="utf-8"?>
<!--
  클라우드 백업과 기기 간 이전에서 앱 데이터를 모두 뺍니다(Android 12+).
  로컬 DB에는 일기 초안과 온보딩 출생 정보가 있고, 보안 저장소 값은 새 기기의
  Keystore 키로 풀 수 없습니다. Android 11 이하는 allowBackup="false"가 막습니다.
  Android 12+에서 allowBackup="false"는 기기 간 이전을 막지 못하므로 이 규칙이 필요합니다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
