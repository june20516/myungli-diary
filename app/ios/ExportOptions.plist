<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TestFlight·App Store용 IPA export 설정(결정 A103). 자동 서명, 팀 7JGP3D7B3Z.
     destination=export는 IPA만 만들고, 올릴 때는 README "iOS TestFlight"대로 destination을 upload로 바꿔
     같은 archive를 다시 export합니다. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>teamID</key>
	<string>7JGP3D7B3Z</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
