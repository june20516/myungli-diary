    "characterReason": {
      "slot": "character.reason",
      "messageKey": "character.reason.yongsin_day",
      "variant": "1",
      "reactable": false,
      "text": {
        "segments": [
          {
            "text": "내 사주에 필요한 기운이 들어와 일이 잘 풀리기 쉬운 날이에요."
          }
        ]
      }
    },
    "fortune": {
      "head": {
        "slot": "daily.fortune.head",
        "messageKey": "fortune.yongsin_day.bigyeop",
        "variant": "advice",
        "reactable": true,
        "text": {
          "segments": [
            {
              "text": "비겁",
              "term": "ten_god_group.bigyeop"
            },
            {
              "text": "이 들어오니, 미뤄 둔 일을 친구와 해 보세요."
            }
          ]
        },
        "todayReason": {
          "segments": [
            {
              "text": "오늘 들어오는 기운이 내 사주를 돕는 쪽이라 그래요."
            }
          ]
        },
        "evidence": [
          {
            "ruleId": "yongsin/eokbu",
            "sourceRef": "gungtong-bogam/five_elements#balance_principle",
            "basis": {
              "segments": [
                {
                  "text": "억부법으로 "
                },
                {
                  "text": "용신",
                  "term": "role.yongsin"
                },
                {
                  "text": "을 정했어요. 내 일간은 힘이 센 편이라, 그 힘을 고르게 맞추는 오행을 골랐어요."
                }
              ]
            },
            "source": {
              "segments": [
                {
                  "text": "넘치는 것은 덜고 모자란 것은 채워 가운데로 돌리는 것이 명리의 핵심이라는 뜻이에요.\n以義推之，夫萬物負陰而抱陽，沖氣以和。過與不及，皆爲乖道。故高者抑之使平，下者舉之使崇，或益其不及，或損其太過。所以貴在折衷，歸於中道，使無有餘不足之累，即才官印食貴人驛馬之微意也。行運亦如之，識其微意，則於命理之說，思過半矣。\n궁통보감 「오행총론」"
                }
              ]
            }
          },
          {
            "ruleId": "fortune/day_kind",
            "sourceRef": "gungtong-bogam/five_elements#balance_principle",
            "basis": {
              "segments": [
                {
                  "text": "오늘은 용신의 날이고 오늘 천간이 내 일간에게 비견에 해당해서, 이 둘을 바탕으로 총운을 골랐어요."
                }
              ]
            },
            "source": {
              "segments": [
                {
                  "text": "넘치는 것은 덜고 모자란 것은 채워 가운데로 돌리는 것이 명리의 핵심이라는 뜻이에요.\n以義推之，夫萬物負陰而抱陽，沖氣以和。過與不及，皆爲乖道。故高者抑之使平，下者舉之使崇，或益其不及，或損其太過。所以貴在折衷，歸於中道，使無有餘不足之累，即才官印食貴人驛馬之微意也。行運亦如之，識其微意，則於命理之說，思過半矣。\n궁통보감 「오행총론」"
                }
              ]
            }
          }
        ]
      },
      "tag": {
        "slot": "daily.fortune.tag",
        "messageKey": "fortune.tag.harmony",
        "variant": "state",
        "reactable": true,
        "text": {
          "segments": [
            {
              "text": "이야기나 약속이 잘 맞아떨어지는 날이에요."
            }
          ]
        }
      }
    },
    "guide": {
