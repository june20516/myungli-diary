      "reactable": false,
      "text": {
        "segments": [
          {
            "text": "오늘 마음이 잘 맞았던 대화가 있었다면 적어 볼까요?"
          }
        ]
      }
    },
    "guideCandidates": [
      {
        "slot": "daily.guide",
        "messageKey": "guide.harmony",
        "variant": "1",
        "reactable": false,
        "text": {
          "segments": [
            {
              "text": "오늘 마음이 잘 맞았던 대화가 있었다면 적어 볼까요?"
            }
          ]
        }
      },
      {
        "slot": "daily.guide",
        "messageKey": "guide.harmony",
        "variant": "2",
        "reactable": false,
        "text": {
          "segments": [
            {
              "text": "오늘 함께해서 좋았던 사람이 있었나요?"
            }
          ]
        }
      },
      {
        "slot": "daily.guide",
        "messageKey": "guide.ten_god_rush.bigyeop",
        "variant": "1",
        "reactable": false,
        "text": {
          "segments": [
            {
              "text": "오늘 끝까지 지키고 싶었던 내 생각을 적어 볼까요?"
            }
          ]
        }
      },
      {
        "slot": "daily.guide",
        "messageKey": "guide.ten_god.bigyeop",
        "variant": "1",
        "reactable": false,
        "text": {
          "segments": [
            {
              "text": "오늘 함께 시간을 보낸 사람이 있었다면 그 이야기를 적어 볼까요?"
            }
          ]
        }
      }
