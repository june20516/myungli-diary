      "variant": "1",
      "reactable": false,
      "text": {
        "segments": [
          {
            "text": "오늘 마음이 잘 맞았던 대화가 있었다면 적어 볼까요?"
          }
        ]
      }
    },
    "guideCandidates": [
      {
        "slot": "daily.guide",
        "messageKey": "guide.harmony",
