      },
      {
        "slot": "daily.guide",
        "messageKey": "guide.ten_god_rush.bigyeop",
        "variant": "1",
        "reactable": false,
        "text": {
          "segments": [
            {
              "text": "오늘 끝까지 지키고 싶었던 내 생각을 적어 볼까요?"
            }
          ]
        }
      },
      {
