    "meanings": {
      "element.earth": {
        "segments": [
          {
            "text": "받쳐 주고 모으는 기운이에요. 중심을 잡고 이어 주는 일에서 드러나요."
          }
        ]
      },
      "element.fire": {
        "segments": [
          {
            "text": "밝게 피어올라 드러나는 기운이에요. 표현하고 알리는 일에서 드러나요."
          }
        ]
      },
      "element.metal": {
        "segments": [
          {
            "text": "단단하게 다듬고 정리하는 기운이에요. 결정하고 마무리하는 일에서 드러나요."
          }
        ]
      },
      "element.water": {
        "segments": [
          {
            "text": "흐르며 스며드는 기운이에요. 생각하고 살피는 일에서 드러나요."
          }
        ]
      },
      "element.wood": {
        "segments": [
          {
            "text": "자라고 뻗어 나가는 기운이에요. 새로 시작하고 키워 가는 일에서 드러나요."
          }
        ]
      },
      "role.day_master": {
        "segments": [
          {
            "text": "태어난 날의 천간으로, 사주에서 '나' 자신을 나타내요. 옆 글자들이 나에게 어떤 기운인지는 모두 일간을 기준으로 읽어요."
          }
        ]
      },
      "tag.cheoneul_gwiin": {
        "segments": [
          {
            "text": "어려울 때 도와주는 사람이 곁에 오는 기운이에요."
          }
        ]
      },
      "tag.clash": {
        "segments": [
          {
            "text": "서로 반대되는 기운이 맞부딪히는 것으로, 계획이 바뀌거나 의견이 갈리기 쉬워요."
          }
        ]
      },
      "tag.dohwa": {
        "segments": [
          {
            "text": "사람의 눈길을 끄는 기운을 뜻하는 신살로, 매력이 드러나고 관심을 받기 쉬워요."
          }
        ]
      },
      "tag.gongmang": {
        "segments": [
          {
            "text": "비어 있는 자리를 뜻하는 신살로, 애쓴 만큼 결과가 바로 손에 잡히지 않을 수 있어요."
          }
        ]
      },
      "tag.harmony": {
        "segments": [
          {
            "text": "서로 다른 기운이 맞물려 하나가 되는 것으로, 사람과 일이 잘 어울려요."
          }
        ]
      },
      "tag.ten_god_rush.bigyeop": {
        "segments": [
          {
            "text": "내 사주에 이미 많은 비겁이 그날 또 들어온 것으로, 나와 내 몫을 앞세우게 돼요."
          }
        ]
      },
      "tag.ten_god_rush.inseong": {
        "segments": [
          {
            "text": "내 사주에 이미 많은 인성이 그날 또 들어온 것으로, 생각이 많아지고 기대고 싶어져요."
          }
        ]
      },
      "tag.yeokma": {
        "segments": [
          {
            "text": "움직임을 뜻하는 신살로, 이동하거나 바깥에 나갈 일이 늘어요."
          }
        ]
      },
      "ten_god.jeonggwan": {
        "segments": [
          {
            "text": "나를 바르게 다잡아 주는 기운이에요. 맡은 일을 차분히 해내는 힘이 돼요."
          }
        ]
      },
      "ten_god_group.bigyeop": {
        "segments": [
          {
            "text": "비견과 겁재를 함께 부르는 이름으로, 나와 어깨를 나란히 하는 기운이에요. 나를 지키고 내 몫을 챙기려는 힘이 여기에 들어요."
          }
        ]
      },
      "ten_god_group.gwanseong": {
        "segments": [
          {
            "text": "편관과 정관을 함께 부르는 이름으로, 나를 다스리는 규칙과 책임을 뜻해요. 직장, 명예, 지켜야 할 약속이 여기에 들어요."
          }
        ]
      },
      "ten_god_group.inseong": {
        "segments": [
          {
            "text": "편인과 정인을 함께 부르는 이름으로, 나를 길러 주는 배움과 보살핌을 뜻해요. 공부, 생각, 받는 도움이 여기에 들어요."
          }
        ]
      },
      "ten_god_group.jaeseong": {
        "segments": [
          {
            "text": "편재와 정재를 함께 부르는 이름으로, 내가 다루고 얻는 돈과 결과를 뜻해요. 살림, 일의 성과, 현실 감각이 여기에 들어요."
          }
        ]
      },
      "ten_god_group.siksang": {
        "segments": [
          {
            "text": "식신과 상관을 함께 부르는 이름으로, 내 안의 것을 밖으로 풀어내는 기운이에요. 말, 표현, 손재주가 여기에 들어요."
          }
        ]
      }
    },
