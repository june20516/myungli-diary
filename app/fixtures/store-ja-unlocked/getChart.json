    "personalReadings": [
      {
        "kind": "day_master",
        "position": "day_stem",
        "text": {
          "segments": [
            {
              "text": "自分の命式の"
            },
            {
              "term": "stem.gyeong",
              "text": "庚金"
            },
            {
              "text": "は、身旺です。"
            },
            {
              "term": "element.water",
              "text": "水"
            },
            {
              "text": "の気はバランスを整えてくれるので取り入れ、"
            },
            {
              "term": "element.earth",
              "text": "土"
            },
            {
              "text": "の気は控えめにするとよいです。"
            }
          ]
        }
      },
      {
        "kind": "ten_god",
        "position": "year_stem",
        "text": {
          "segments": [
            {
              "text": "年干に"
            },
            {
              "term": "ten_god.bigyeon",
              "text": "比肩"
            },
            {
              "text": "があり、肩を並べて歩く人の力が土台にあります。この位置の五行は"
