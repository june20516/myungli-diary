{
  "hosting": {
    "target": "landing",
    "public": "site/dist",
    "ignore": [
      "**/.*"
    ],
    "cleanUrls": false,
    "appAssociation": "NONE",
    "i18n": {
      "root": "/i18n"
    },
    "headers": [
      {
        "source": "/app-ads.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "regex": "^/(?:[^.]*/)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "emulators": {
    "hosting": {
      "host": "127.0.0.1",
      "port": 47291
    },
    "ui": {
      "enabled": false
    },
    "hub": {
      "port": 47292
    },
    "logging": {
      "port": 47293
    }
  }
}
