---
// 모든 페이지의 <head>: 제목, 설명, 아이콘, canonical, hreflang, OG.
import "@myungli/tokens/tokens.css";
import { LANGS, type Lang } from "../config/lang.ts";
import { siteConfig } from "../config/site.ts";
import { landingFonts } from "../fonts/landing.ts";
import { fontFaceCss } from "../fonts/web.ts";
import { FAVICON_ICO_SIZES, PNG_ICONS } from "../icons/favicon.ts";

interface Props {
  /** <html lang>와 웹 글꼴 언어. 언어 고르기 페이지(/)와 루트 404는 en. */
  htmlLang: Lang;
  title: string;
  description: string;
  /** origin 뒤 경로, 빗금으로 시작하고 끝남. 없으면(404) canonical과 og:url을 내지 않습니다. */
  path?: string;
  ogImagePath: string;
  ogLocale: string;
}

const { htmlLang, title, description, path, ogImagePath, ogLocale } = Astro.props;
const absolute = (pathname: string) => `${siteConfig.origin}${pathname}`;
const fontCss = fontFaceCss(await landingFonts(htmlLang));
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes={FAVICON_ICO_SIZES.map((size) => `${size}x${size}`).join(" ")} />
    <link rel="icon" type="image/png" href={PNG_ICONS.large.path} sizes={`${PNG_ICONS.large.size}x${PNG_ICONS.large.size}`} />
    <link rel="apple-touch-icon" href={PNG_ICONS.touch.path} />
    {!siteConfig.indexable && <meta name="robots" content="noindex" />}
    {path !== undefined && <link rel="canonical" href={absolute(path)} />}
    {LANGS.map((lang) => <link rel="alternate" hreflang={lang} href={absolute(`/${lang}/`)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute("/")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {path !== undefined && <meta property="og:url" content={absolute(path)} />}
    <meta property="og:image" content={absolute(ogImagePath)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <style set:html={fontCss}></style>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* V137 "글자와 줄바꿈", "테마, 포커스, 움직임". 다크는 토큰이 prefers-color-scheme로 바꿉니다. */
  :root {
    color-scheme: light dark;
    --gutter: max(var(--space-20), 5vw);
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    overflow-x: clip;
    background: var(--color-bg-base);
    color: var(--color-text-primary);
    font-family: var(--type-body-ui-font-family);
    font-size: 16px;
    line-height: 1.55;
    font-synthesis: none;
  }
  :root:lang(ko) body {
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  :root:lang(ja) body {
    word-break: auto-phrase;
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 2px solid var(--color-action-primary);
    outline-offset: 3px;
    border-radius: var(--radius-xs);
  }
</style>
