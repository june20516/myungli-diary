---
// 없는 주소(IA web-not-found): 제목, 안내 한 문장, 랜딩으로 가는 링크 하나. 바탕은 랜딩 바탕 띠와 같은 오늘 그라데이션입니다.
import type { Lang } from "../config/lang.ts";
import { loadCopy } from "../copy/load.ts";
import { OG_LOCALE } from "../i18n/locale.ts";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = loadCopy(lang);
---

<Base
  htmlLang={lang}
  title={copy.text("web-not-found.meta.title")}
  description={copy.text("web-landing.meta.description")}
  ogImagePath={`/${lang}/og.png`}
  ogLocale={OG_LOCALE[lang]}
>
  <main class="not-found">
    <h1 class="title">{copy.text("web-not-found.page.title")}</h1>
    <p class="body">{copy.text("web-not-found.page.body")}</p>
    <a class="home" href={`/${lang}/`}>{copy.text("web-not-found.page.home")}</a>
  </main>
</Base>

<style>
  .not-found {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-16);
    min-height: 100svh;
    box-sizing: border-box;
    padding: var(--space-48) var(--gutter);
    background: var(--gradient-today);
    text-align: center;
  }
  .title {
    margin: 0;
    font-family: var(--font-family-sentence);
    font-size: clamp(26px, 3.6vw, 36px);
    font-weight: 400;
    line-height: 1.35;
    text-wrap: balance;
  }
  .body {
    max-width: 34em;
    margin: 0;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  .home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-8);
    color: var(--color-action-primary);
    font-weight: 600;
    text-underline-offset: 3px;
  }
</style>
