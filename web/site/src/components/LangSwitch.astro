---
// 언어 바꾸기(V137 "아래쪽"). 각 언어 이름은 그 언어로 씁니다(원고 아님).
import { LANGS, type Lang } from "../config/lang.ts";
import { LANG_NATIVE_NAME } from "../i18n/locale.ts";

interface Props {
  current: Lang;
  label: string;
}

const { current, label } = Astro.props;
---

<nav class="lang" aria-label={label}>
  {
    LANGS.map((lang) => (
      <a href={`/${lang}/`} hreflang={lang} lang={lang} aria-current={lang === current ? "page" : undefined}>
        {LANG_NATIVE_NAME[lang]}
      </a>
    ))
  }
</nav>

<style>
  .lang {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
  }
  a[aria-current="page"] {
    color: var(--color-action-primary);
    font-weight: var(--type-label-lg-font-weight);
  }
</style>
